# S9/W5 数据面镜像 (specs/rtw88-adapt/SPEC.md §4/W5):
# rtw88-wpa 形态 + lwip (纯栈, GMAC 载体关) + CONFIG_WLAN_NETIF ->
# wlanrtw_netif.c (deliver seam -> pbuf -> tcpip_input; linkoutput ->
# net80211 if_snd 单通道) + netutils ping/iperf3 打点面。
# 判据: netif up mac=efuse -> DHCP 四锚 -> ping 网关 10/10 -> iperf
# >=60s 双向打点 (不设门槛)。
CONFIG_OPT := -Og
CONFIG_OS := threadx
CONFIG_TX_TICKS_PER_SECOND := 1000
CONFIG_TX_TIMER_STACK := 4096
CONFIG_TX_MAX_THREADS := 24
CONFIG_HEAP_BYTES := 0x800000
CONFIG_SHELL := y
CONFIG_SHELL_STACK := 16384
CONFIG_UART_RX_IRQ := y
CONFIG_USBHOST := y
CONFIG_USBHOST_XHCI := y
CONFIG_USBHOST_XHCI_START_NUM := 2
CONFIG_LINUXKPI := y
CONFIG_LINUXKPI_80211 := y
CONFIG_NIC_RTW88 := y
CONFIG_NET80211 := y
CONFIG_WPA_SUPPLICANT := y
CONFIG_WPA_BACKEND := vendor
CONFIG_WPA_L2 := direct
CONFIG_WPA_THREAD_STACK := 65536
CONFIG_WPA_SUPP_DEBUG_LEVEL := 2
CONFIG_RTW88_WPA_BACKEND := y
# W5 新因素: lwip 纯栈 (GMAC 载体关 - wlan netif 桥own缝) + 工具面
CONFIG_LWIP := y
CONFIG_LWIP_GMAC := n
CONFIG_WLAN_NETIF := y
CONFIG_NETUTILS := y
CONFIG_NETUTILS_PING := y
CONFIG_NETUTILS_IPERF3 := y
CONFIG_LIBC_COMPLETION := y
