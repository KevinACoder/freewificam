# P7-2a lwip_lan 配置 (specs/lwip-adapt/SPEC.md §3.2.3 阶段二列): NO_SYS=0 +
# sys_arch 跑在 cmsis2_threadx 上, threadx 基座 (S3)。lwip 选项在
# os/lwip/include/lwipopts.h (第一方, 阶段二列已切)。
# GMAC 端口构建期单选 (FR-9/KI-027) 不变; 主判据口 = gmac1。
CONFIG_OPT := -Og
CONFIG_OS := threadx
CONFIG_TX_TICKS_PER_SECOND := 1000
CONFIG_TX_TIMER_STACK := 4096
CONFIG_TX_MAX_THREADS := 16
CONFIG_HEAP_BYTES := 0x400000
# cherrysh 命令面 (N1 判据 1: cmd_ping/tftp/iperf3 导出; N2-N4 交互载体)
CONFIG_SHELL := y
CONFIG_SHELL_STACK := 4096
CONFIG_UART_RX_IRQ := y
CONFIG_GMAC_PORT := 1
CONFIG_LWIP := y
# netutils 工具面 (S7b/N1): socket 公民, 三子键单因素 (specs/netutils-adapt FR-12)
CONFIG_NETUTILS := y
CONFIG_NETUTILS_PING := y
CONFIG_NETUTILS_TFTP := y
CONFIG_NETUTILS_IPERF3 := y
