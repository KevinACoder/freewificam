# P7-2a lwip_lan 配置 (specs/lwip-adapt/SPEC.md §3.2.3 阶段二列): NO_SYS=0 +
# sys_arch 跑在 cmsis2_threadx 上, threadx 基座 (S3)。lwip 选项在
# os/lwip/include/lwipopts.h (第一方, 阶段二列已切)。
# GMAC 端口构建期单选 (FR-9/KI-027) 不变; 主判据口 = gmac1。
CONFIG_OPT := -Og
CONFIG_OS := threadx
CONFIG_TX_TICKS_PER_SECOND := 1000
CONFIG_TX_TIMER_STACK := 4096
CONFIG_TX_MAX_THREADS := 16
CONFIG_HEAP_BYTES := 0x400000
CONFIG_GMAC_PORT := 1
CONFIG_LWIP := y
