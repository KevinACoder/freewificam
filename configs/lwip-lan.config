# P7-2a lwip_lan 配置 (specs/lwip-adapt/SPEC.md §3.2.3 阶段二列): NO_SYS=0 +
# sys_arch 跑在 cmsis2_threadx 上, threadx 基座 (S3)。lwip 选项在
# os/lwip/include/lwipopts.h (第一方, 阶段二列已切)。
# GMAC 端口构建期单选 (FR-9/KI-027) 不变; 主判据口 = gmac1。
# N7 R6 B3-cheap: -Og was the bring-up default; the per-frame TCP path is
# CPU-bound (~29us/frame at 816MHz), so the throughput config builds -O2.
CONFIG_OPT := -O2
CONFIG_OS := threadx
CONFIG_TX_TICKS_PER_SECOND := 1000
CONFIG_TX_TIMER_STACK := 4096
CONFIG_TX_MAX_THREADS := 16
CONFIG_HEAP_BYTES := 0x400000
# cherrysh 命令面 (N1 判据 1: cmd_ping/tftp/iperf3 导出; N2-N4 交互载体)
CONFIG_SHELL := y
CONFIG_SHELL_STACK := 4096
CONFIG_UART_RX_IRQ := y
CONFIG_GMAC_PORT := 1
CONFIG_LWIP := y
# netutils 工具面 (S7b/N1): socket 公民, 三子键单因素 (specs/netutils-adapt FR-12)
CONFIG_NETUTILS := y
CONFIG_NETUTILS_PING := y
CONFIG_NETUTILS_TFTP := y
CONFIG_NETUTILS_IPERF3 := y
# lwiperf client 前端 (N7 R3): TX 零拷贝测量口径 (对 PC iperf2 -s)
CONFIG_NETUTILS_IPERF2 := y
# N7 R3 A/B 因子 (2026-10-02 R3 板测定案, 双 y 成为后续轮新基线):
#   RX_HWCSUM   反向 +19.5% (240->287M 板侧), csdrop=0
#   RX_COALESCE 再 +25% 反向 (->357M) 且正向 +31% (374->490M, ACK 流中断
#               风暴被同一机制压掉), ping 0.755ms 仍在 <1ms 判据内
CONFIG_GMAC_RX_HWCSUM := y
CONFIG_GMAC_RX_COALESCE := y
CONFIG_GMAC_RX_RIWT := 0xa0
# N7 R4: RX 零拷贝 (custom pbuf 槽位借出, 无 ISR 拷贝/无 stage 环)
CONFIG_GMAC_RX_ZC := y
# N7 R5a: CPU 频率/电压一次成型 (Linux opp 配对: i2c0->RK809 buck1 先升压,
# 再 APLL 重锁; 0 = 仅探测记录继承电压)。阶梯 1104/1416/1608/1800。
CONFIG_CPU_BOOST_MHZ := 1800
# N7 R5b: SCMI 时钟探针 (SMC 0x82000010 + shmem@0x10f000, BL31 载体)。
# 纯 shell 诊断面 (scmi ver/attr/get/set + freq), 开机零动作; 提频产品化
# 载体 (c1) 由板测定案后裁决。
CONFIG_SCMI_PROBE := y
# 取证旋钮 (2026-10-02 控制台 RX 失效轮): 1s 心跳追加 UART RX 病理行
# (uart diag + ISR/ring/consume 计数)。问题定案后关掉。
CONFIG_SHELL_RX_DIAG := y
# N7 R5b 开机自动打流 (原为控制台 RX 失效的无人值守 workaround):
# 2026-10-02 会诊证实控制台 RX 正常（同镜像冷启即活），测量改回
# 交互口径 (shell / PC 侧 iperf2)，自动打流停用 (空 = 不编入)。
CONFIG_IPERF2_AUTO_HOST :=
# SCMI 开机 set_rate 档位 (OPP 行; 0 = 只探不写)。阶梯轮逐档改这里。
CONFIG_SCMI_BOOT_SET_MHZ := 0
# N7-stab 取证三件 (2026-10-02 持续 TX 15-30s 冻结轮)：
#   TICK_MON    CNTP 看护 (0x60 优先级, 高于 GMAC 0xa0)——tick 停摆即打
#               GMAC 现场 (emergency 通道, 无锁); 正常时静默零开销~1us/250ms
#   FAST_PROBE  Realtime 探针线程, 前 60s 10Hz 快照 (线程 run_count + tx 环
#               + sem + heap + 锁), 之后 1Hz; 冻结前最后一帧即现场
#   IRQ_BREAKER 未服务状态位风暴 >=32 次/100ms 自动摘 AIE (风暴自愈保活),
#               首报打 emergency 行——把整机冻结转成带证据的降级
CONFIG_GMAC_TICK_MON := y
CONFIG_GMAC_FAST_PROBE := y
CONFIG_GMAC_IRQ_BREAKER := y
