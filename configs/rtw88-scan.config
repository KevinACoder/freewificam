# S9/W3 rtw88 桥+scan (specs/rtw88-adapt/SPEC.md §4/W3):
# rtw88-board 形态 + CONFIG_NET80211——vendored 协议核心 + compat 三件
# + lkpi_bridge(真桥,覆盖 W2 弱桩) + wlanrtw 命令面。
# 判据: wlanrtw scan → ≥1 真实 BSSID;rx_irqsafe/入表计数增长;连续 5 扫无泄漏。
CONFIG_OPT := -Og
CONFIG_OS := threadx
CONFIG_TX_TICKS_PER_SECOND := 1000
CONFIG_TX_TIMER_STACK := 4096
CONFIG_TX_MAX_THREADS := 16
CONFIG_HEAP_BYTES := 0x400000
CONFIG_SHELL := y
CONFIG_SHELL_STACK := 4096
CONFIG_UART_RX_IRQ := y
CONFIG_USBHOST := y
CONFIG_USBHOST_XHCI := y
CONFIG_USBHOST_XHCI_START_NUM := 2
CONFIG_LINUXKPI := y
CONFIG_LINUXKPI_80211 := y
CONFIG_NIC_RTW88 := y
CONFIG_NET80211 := y
# W3 进行态注记: bridge+scan 状态机板上稳定运行, RX beacon 交付链未通
# (scan 表空)——下轮首查 usbkpi 抓 ep84 完成 (需先关 CONFIG_HEAP_FREE_LOG 取证)
