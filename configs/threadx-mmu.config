# S3/T1 threadx 配置 (specs/threadx-up-boot/SPEC.md v2.1 §3.1.3): MMU 基础 +
# CONFIG_OS=threadx 换入 ThreadX UP 内核 (cmsis2_shim.c 互斥退出).
CONFIG_OPT := -Og
CONFIG_OS := threadx
# tick 率 = 1000Hz (2026-09-30 用户裁决, 开放问题 1; 裸跑保持 100Hz)
CONFIG_TX_TICKS_PER_SECOND := 1000
# 内核 timer 线程栈 (spec §3.5.3; 前作 16384 是驱动线规模, 本轮取默认值并键化)
CONFIG_TX_TIMER_STACK := 4096
# CMSIS slot 池上限 (spec §3.5.2; 冒烟 + cherrysh 单实例够用, 超限改键即可)
CONFIG_TX_MAX_THREADS := 16
# 系统 heap (= baremetal.ld 的 4M 预留; 前作 100MB 是驱动线规模)
CONFIG_HEAP_BYTES := 0x400000
# S4 cherrysh (specs/cherrysh-adapt/SPEC.md): shell 只在 threadx 配置存在 (N11);
# CONFIG_SHELL=0 对照构建用 `make CONFIG=threadx-mmu CONFIG_SHELL=n` 命令行覆盖.
CONFIG_SHELL := y
# shell 任务栈 (spec §3.8.3; 前作板验值)
CONFIG_SHELL_STACK := 4096
# UART RX 中断接收 (spec §3.4, S4-a 前置切片; 裸跑配置不开)
CONFIG_UART_RX_IRQ := y
