# S5b W3 取证配置（runs/20261004-rtl8851bu-w3-rtos 续轮）：wlan8851.config
# 的取证加成——同基座 + 两个诊断键（产品面配置不动）。单变量纪律：本文件
# 只在板轮取证用，收口时随镜像一并移除/关闭。
#
#  CONFIG_WLAN_MON     thread/mutex/semaphore 表倾印（os/threadx/mon.c，10s）
#                      + CNTP IRQ 看护（2s，raw prio 0x60）+ `wlan8851 mon`
#  CONFIG_WLAN_AUTORUN up→scan→bss 无人值守（app/wlan8851/main.c）
#
# 其余键逐字复制 wlan8851.config（含 wlan8851bu 全 vendor 面）。
CONFIG_OPT := -Og
CONFIG_OS := threadx
CONFIG_TX_TICKS_PER_SECOND := 1000
CONFIG_TX_TIMER_STACK := 4096
CONFIG_TX_MAX_THREADS := 24
CONFIG_HEAP_BYTES := 0x2c00000
CONFIG_SHELL := y
CONFIG_SHELL_STACK := 16384
CONFIG_UART_RX_IRQ := y
CONFIG_USBHOST := y
CONFIG_USBHOST_XHCI := y
CONFIG_USBHOST_XHCI_START_NUM := 2
CONFIG_LINUXKPI := y
CONFIG_LINUXKPI_UDISK := n
CONFIG_LINUXKPI_USB_RX_ASYNC := y
CONFIG_LINUXKPI_STAGE_SMALL_N := 18
CONFIG_NIC_RTL8851BU := y
CONFIG_RTW_LOG_LEVEL := 3
# --- the two forensic keys ---
CONFIG_WLAN_MON := y
CONFIG_WLAN_AUTORUN := y
