# S9/W4 WPA2 镜像 (specs/rtw88-adapt/SPEC.md §4/W4):
# rtw88-scan 形态 + wpa_supplicant (trunk 产物, vendor 后端) +
# CONFIG_RTW88_WPA_BACKEND -> wpa_vendor_rtw88.c (net80211 bridge 九 op)。
# 判据: wpa connect <ssid> <psk> -> 4-way (PTK=CCMP GTK=CCMP) ->
# CTRL-EVENT-CONNECTED -> 连接保持 >=60s; sta_add/set_key/bss_info_changed
# 各 >=1 命中打印。
CONFIG_OPT := -Og
CONFIG_OS := threadx
CONFIG_TX_TICKS_PER_SECOND := 1000
CONFIG_TX_TIMER_STACK := 4096
CONFIG_TX_MAX_THREADS := 24
# supplicant 的 bss 表/事件队列/64K 线程栈都吃 tlsf 堆 (wpa-smoke 前例)
CONFIG_HEAP_BYTES := 0x800000
CONFIG_SHELL := y
CONFIG_SHELL_STACK := 4096
CONFIG_UART_RX_IRQ := y
CONFIG_USBHOST := y
CONFIG_USBHOST_XHCI := y
CONFIG_USBHOST_XHCI_START_NUM := 2
CONFIG_LINUXKPI := y
CONFIG_LINUXKPI_80211 := y
CONFIG_NIC_RTW88 := y
CONFIG_NET80211 := y
# W4 新因素: wpa_supplicant + vendor 后端 (单因素轮)
CONFIG_WPA_SUPPLICANT := y
CONFIG_WPA_BACKEND := vendor
CONFIG_WPA_L2 := direct
CONFIG_WPA_THREAD_STACK := 65536
CONFIG_WPA_SUPP_DEBUG_LEVEL := 2
CONFIG_RTW88_WPA_BACKEND := y
# minilibc libc 补全门控 (wpa 世界需要, 与 wpa-smoke 同门)
CONFIG_LIBC_COMPLETION := y
