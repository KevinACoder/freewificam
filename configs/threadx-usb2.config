# P5-b cherryusb xHCI 双实例配置 (specs/cherryusb-xhci-port/SPEC.md v2.3 §4/P5-b):
# = threadx-usb (P5-a) + CONFIG_USBHOST_XHCI_START_NUM=2 —— busid 2 (0xFD000000)
# ready 之后串行 start busid 3 (0xFCC00000, OTG 强转 host, GL hub 载体)，
# 域串行纪律 spec §3.2.2（两实例 start 不得交错进域序列之间）。
CONFIG_OPT := -Og
CONFIG_OS := threadx
CONFIG_TX_TICKS_PER_SECOND := 1000
CONFIG_TX_TIMER_STACK := 4096
CONFIG_TX_MAX_THREADS := 16
CONFIG_HEAP_BYTES := 0x400000
CONFIG_SHELL := y
CONFIG_SHELL_STACK := 4096
CONFIG_UART_RX_IRQ := y
CONFIG_USBHOST := y
CONFIG_USBHOST_XHCI := y
CONFIG_USBHOST_XHCI_START_NUM := 2
