# S5b W4 数据面配置（runs/20261004-rtl8851bu-w3-rtos 续轮）：wlan8851-w3mon.config
# 基础上把 lwIP 栈 + wlan netif 桥 + netutils(ping) 带进镜像，**不挂 GMAC**
# —— KI-027 单网卡形态（无线的 netif 是产品里唯一的一个）。
#
# 与 8821 线 lwip-wlan.config 的差异：8851 的堆/窗口键（44M + dma_noc
# 0x0e000000）与 vendor 配置键（NIC_RTL8851BU / RTW_LOG_LEVEL=3）沿用本线。
# 命名注记：取证配置保留 WLAN_MON/AUTORUN 两键（本镜像同时是连接轮的
# 取证载体；收口时随镜像一并归档）。
CONFIG_OPT := -O2
CONFIG_OS := threadx
CONFIG_TX_TICKS_PER_SECOND := 1000
CONFIG_TX_TIMER_STACK := 4096
CONFIG_TX_MAX_THREADS := 24
CONFIG_HEAP_BYTES := 0x2c00000
CONFIG_SHELL := y
CONFIG_SHELL_STACK := 16384
CONFIG_UART_RX_IRQ := y
CONFIG_USBHOST := y
CONFIG_USBHOST_XHCI := y
CONFIG_USBHOST_XHCI_START_NUM := 2
CONFIG_LINUXKPI := y
CONFIG_LINUXKPI_UDISK := n
CONFIG_LINUXKPI_USB_RX_ASYNC := y
CONFIG_LINUXKPI_STAGE_SMALL_N := 18
CONFIG_NIC_RTL8851BU := y
CONFIG_RTW_LOG_LEVEL := 3
# W4 数据面：lwIP + wlan netif 桥 + netutils(ping)
CONFIG_LWIP := y
# 留空 = 无 GMAC（KI-027 单网卡）
CONFIG_GMAC_PORT :=
CONFIG_WLAN_NETIF := y
CONFIG_NETUTILS := y
CONFIG_NETUTILS_PING := y
# --- the forensic keys (kept for this board round) ---
CONFIG_WLAN_MON := y
CONFIG_WLAN_AUTORUN := y
