# S7a/P7a wpa_supplicant 组件冒烟配置 (specs/wpa-supplicant-rtos-adapt/SPEC.md
# §4/P7a-1): threadx 基座 + cherrysh + wpa，无 USB/wlan/lwip——"无网卡也能活着"
# 正是冒烟切片要证明的。后端轮次:
#   P7a-1 = CONFIG_WPA_BACKEND=none + CONFIG_WPA_L2=none (vendored 桩)
#   P7a-2 = CONFIG_WPA_BACKEND=vendor + CONFIG_WPA_L2=direct (骨架 fail-safe)
CONFIG_OPT := -Og
CONFIG_OS := threadx
CONFIG_TX_TICKS_PER_SECOND := 1000
CONFIG_TX_TIMER_STACK := 4096
CONFIG_TX_MAX_THREADS := 16
# supplicant 的 bss 表/事件队列/64K 线程栈都吃 tlsf 堆，给足
CONFIG_HEAP_BYTES := 0x800000
CONFIG_SHELL := y
CONFIG_SHELL_STACK := 16384
CONFIG_UART_RX_IRQ := y
# S7a wpa 组件 (specs/wpa-supplicant-rtos-adapt/SPEC.md)
CONFIG_WPA_SUPPLICANT := y
CONFIG_WPA_BACKEND := none
CONFIG_WPA_L2 := none
CONFIG_WPA_THREAD_STACK := 65536
CONFIG_WPA_SUPP_DEBUG_LEVEL := 2
