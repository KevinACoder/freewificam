# S5b W1 wlan8851 配置 (specs/rtl8851bu-vendor-driver/SPEC.md v3.2 §4/W1):
# wlan8821 同族血统 —— threadx-lkpi 基座：USB host (XHCI×2) + linuxkpi vendor
# 增量档 + shell，rtl8851bu vendor 驱动进镜像（CONFIG_NIC_RTL8851BU）。
# 裁剪面（单因素纪律，与 wlan8821 同款）：
#  - 不编 GMAC/lwip/netutils（W1-W4 无网络栈，KI-027 单网卡形态）
#  - 不编 U 盘/hub 验收驱动（CONFIG_LINUXKPI_UDISK=n）
#  - 不开 CPU_BOOST / 不进 wpa 组件（W4 轮再开）
#  - V5 特有：无 modeswitch 层（0bda:b851 直枚举，W0-B 实证）；POWER_SAVE 不
#    定义（W0-B 板证同款，PHL phl_ps 不编译，KI-027 无 IPS/LPS 可关）
# 命名注记：spec 原文 wlan-rtl8851bu.config，批准计划定名 wlan8851.config
# （wlan8821 简写先例）。
CONFIG_OPT := -Og
CONFIG_OS := threadx
CONFIG_TX_TICKS_PER_SECOND := 1000
CONFIG_TX_TIMER_STACK := 4096
# vendor 线 + linuxkpi worker + shell 线程族，与 wlan8821 同款放宽
CONFIG_TX_MAX_THREADS := 24
# V5 PHL 树的 fw 数组 ≈517KB（hal8851b fw U1+U2）比 8821 fw 更大，堆同款 8MB
CONFIG_HEAP_BYTES := 0x800000
CONFIG_SHELL := y
# PHL init/固件下发调用深度与 8821 同量级，沿用 16K shell 栈教训值
# （[S5a] W3：4K 栈溢进 tlsf 堆， smashing live TX_SEMAPHORE）
CONFIG_SHELL_STACK := 16384
CONFIG_UART_RX_IRQ := y
CONFIG_USBHOST := y
CONFIG_USBHOST_XHCI := y
# 双实例：busid 2 = 0xFD000000 直插口（8851bu 靶位，W0-B 同口），busid 3 =
# 0xFCC00000（P5-b 拓扑继承；wlan 靶直插 bus2，GL hub 口留空）
CONFIG_USBHOST_XHCI_START_NUM := 2
CONFIG_LINUXKPI := y
CONFIG_LINUXKPI_UDISK := n
# bulk IN async（8821 W3 教训：RX urb 等信标，同步轮询会拖死 ndo_open/scan）
CONFIG_LINUXKPI_USB_RX_ASYNC := y
CONFIG_LINUXKPI_STAGE_SMALL_N := 18
CONFIG_NIC_RTL8851BU := y
# vendor 日志级（configs/ 唯一出处，Makefile 纯消费）：3 = WARNING 档
# （运行时档位 `wlan8851 dbg <1-10>`）；PHL 侧 RTW_PHL_LOG_LEVEL=4 固定
# （W0-B 板证值）
CONFIG_RTW_LOG_LEVEL := 3
