# S5b W6 静默打点配置（runs/20261004-rtl8851bu-w6）：wlan8851-w6 原样 minus 打印
# 噪声源——用户裁决 2026-10-04："打印噪声太多，iperf 前要清理，不然数据无意义"。
# 差异：CONFIG_WLAN_MON=n（2s irq 哨兵 + 10s dump + kpi 周期行全消；sync-cost
# 采样打印同随 MON 门控——linuxkpi_usb.c [W6] 注记）；CONFIG_RTW_PHL_LOG_LEVEL=1
# （PHL info 级噪声含 iperf 期 RX reorder 释放洪流；连接后另用 `wlan8851 dbg 1`
# 运行时压掉 core ERROR seq_no 噪声）。
# 连接判据锚点不受影响：4-way/CONNECTED 在 wpa_supplicant 自有打印、DHCP 在
# netif 自有打印、attach 在适配层自有打印。soak 期异常仍可见（fault park 走
# emergency 出口，不问日志档）。
CONFIG_OPT := -O2
CONFIG_OS := threadx
CONFIG_TX_TICKS_PER_SECOND := 1000
CONFIG_TX_TIMER_STACK := 4096
CONFIG_TX_MAX_THREADS := 24
CONFIG_HEAP_BYTES := 0x2c00000
CONFIG_SHELL := y
CONFIG_SHELL_STACK := 16384
CONFIG_UART_RX_IRQ := y
CONFIG_USBHOST := y
CONFIG_USBHOST_XHCI := y
CONFIG_USBHOST_XHCI_START_NUM := 2
CONFIG_LINUXKPI := y
CONFIG_LINUXKPI_UDISK := n
CONFIG_LINUXKPI_USB_RX_ASYNC := y
CONFIG_LINUXKPI_STAGE_SMALL_N := 18
CONFIG_NIC_RTL8851BU := y
CONFIG_RTW_LOG_LEVEL := 3
CONFIG_RTW_PHL_LOG_LEVEL := 1
# 数据面：lwIP + wlan netif 桥 + netutils（W6 吞吐打点 = iperf3 上行 + ping）
CONFIG_LWIP := y
# 留空 = 无 GMAC（KI-027 单网卡）
CONFIG_GMAC_PORT :=
CONFIG_WLAN_NETIF := y
CONFIG_NETUTILS := y
CONFIG_NETUTILS_PING := y
CONFIG_NETUTILS_IPERF3 := y
# wpa_supplicant（PSK-only；vendor 后端 = 8851 适配层）
CONFIG_WPA_SUPPLICANT := y
CONFIG_WPA_BACKEND := vendor
CONFIG_WPA_L2 := direct
CONFIG_WPA_THREAD_STACK := 65536
# MSG_INFO（W7 print-clean 口径：锚点保留、chatter 收掉）
CONFIG_WPA_SUPP_DEBUG_LEVEL := 3
# minilibc libc 补全门控（P7a-2 零侵入判据：只有消费方配置打开）
CONFIG_LIBC_COMPLETION := y
# --- quiet: forensics off for clean throughput numbers ---
CONFIG_WLAN_MON := n
CONFIG_WLAN_AUTORUN := n
