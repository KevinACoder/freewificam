# S5b W4 wpa 配置（runs/20261004-rtl8851bu-w4）：wlan8851-w4lwip.config 基础上
# 加上 wpa_supplicant 组件线（PSK-only）+ rtl8851bu 的 vendor 后端
# （port/adapters/rtl8851bu/wpa_vendor_rtl8851bu.c）。
#
# AUTORUN 关（**缺陷 A** — rescan-rx-stall：第二次 scan 后 RX 停摆；wpa 流程
# 自带一次 scan，AUTORUN 再扫即触雷）。MON 保留（取证设施，收口时归档）。
CONFIG_OPT := -O2
CONFIG_OS := threadx
CONFIG_TX_TICKS_PER_SECOND := 1000
CONFIG_TX_TIMER_STACK := 4096
CONFIG_TX_MAX_THREADS := 24
CONFIG_HEAP_BYTES := 0x2c00000
CONFIG_SHELL := y
CONFIG_SHELL_STACK := 16384
CONFIG_UART_RX_IRQ := y
CONFIG_USBHOST := y
CONFIG_USBHOST_XHCI := y
CONFIG_USBHOST_XHCI_START_NUM := 2
CONFIG_LINUXKPI := y
CONFIG_LINUXKPI_UDISK := n
CONFIG_LINUXKPI_USB_RX_ASYNC := y
CONFIG_LINUXKPI_STAGE_SMALL_N := 18
CONFIG_NIC_RTL8851BU := y
CONFIG_RTW_LOG_LEVEL := 3
# W4 数据面：lwIP + wlan netif 桥 + netutils(ping)
CONFIG_LWIP := y
# 留空 = 无 GMAC（KI-027 单网卡）
CONFIG_GMAC_PORT :=
CONFIG_WLAN_NETIF := y
CONFIG_NETUTILS := y
CONFIG_NETUTILS_PING := y
# wpa_supplicant（PSK-only；vendor 后端 = 8851 适配层）
CONFIG_WPA_SUPPLICANT := y
CONFIG_WPA_BACKEND := vendor
CONFIG_WPA_L2 := direct
CONFIG_WPA_THREAD_STACK := 65536
# MSG_INFO（W7 print-clean 口径：锚点保留、chatter 收掉）
CONFIG_WPA_SUPP_DEBUG_LEVEL := 3
# minilibc libc 补全门控（P7a-2 零侵入判据：只有消费方配置打开）
CONFIG_LIBC_COMPLETION := y
# --- the forensic keys ---
CONFIG_WLAN_MON := y
CONFIG_WLAN_AUTORUN := n
