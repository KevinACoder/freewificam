# S9/W1 rtw88 编译面 (specs/rtw88-adapt/SPEC.md §4/W1):
# threadx-lkpi 基座 + linuxkpi-80211 shim + rtw88 20 TU 冻结副本 + fw blob。
# 纯编译轮: 无 USB 认领钩 (W2)、无 net80211 桥 (W3, 弱符号默认顶位)。
CONFIG_OPT := -Og
CONFIG_OS := threadx
CONFIG_TX_TICKS_PER_SECOND := 1000
CONFIG_TX_TIMER_STACK := 4096
CONFIG_TX_MAX_THREADS := 16
CONFIG_HEAP_BYTES := 0x400000
CONFIG_SHELL := y
CONFIG_SHELL_STACK := 4096
CONFIG_UART_RX_IRQ := y
CONFIG_USBHOST := y
CONFIG_USBHOST_XHCI := y
CONFIG_USBHOST_XHCI_START_NUM := 2
CONFIG_LINUXKPI := y
CONFIG_LINUXKPI_80211 := y
CONFIG_NIC_RTW88 := y
