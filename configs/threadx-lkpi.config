# P6-a linuxkpi 配置 (specs/linuxkpi/SPEC.md v2.1 §4/P6-a):
# = threadx-usb (P5-a 全量) + CONFIG_LINUXKPI —— linuxkpi 兼容层 + MSC 认领钩子
# + lkpi_udisk 验收驱动 RTOS 壳 + usbkpi 对拍环命令。
# 认领唯一性定案 (实现轮 2026-10-01, spec P6-b 判据 5): 本配置不编
# CONFIG_USBHOST_MSC —— usbh_msc 与 lkpi MSC 钩子配置级互斥, 同盘只被一方认领。
CONFIG_OPT := -Og
CONFIG_OS := threadx
CONFIG_TX_TICKS_PER_SECOND := 1000
CONFIG_TX_TIMER_STACK := 4096
CONFIG_TX_MAX_THREADS := 16
CONFIG_HEAP_BYTES := 0x400000
CONFIG_SHELL := y
CONFIG_SHELL_STACK := 4096
CONFIG_UART_RX_IRQ := y
CONFIG_USBHOST := y
CONFIG_USBHOST_XHCI := y
# 双实例 (busid 2 = 0xFD000000 假光载直插; busid 3 = 0xFCC00000 GL hub,
# U 盘 325d:6410 靶在其下游 —— P5-b 同拓扑, 域串行 spec §3.2.2)
CONFIG_USBHOST_XHCI_START_NUM := 2
# linuxkpi 面 (P6-a): core+usb+fw registry, MSC 认领钩子, usbkpi, lkpi_udisk
CONFIG_LINUXKPI := y
# U 盘/hub 验收驱动随行 (S5a W1 起从 LINUXKPI 拆出的单因素键; 本配置保持
# 原行为 = y, wlan8821.config 取 n)
CONFIG_LINUXKPI_UDISK := y
