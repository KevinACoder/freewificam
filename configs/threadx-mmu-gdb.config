# S3/T4 threadx gdb 配置 (specs/threadx-up-boot/SPEC.md v2.1 §3.6): threadx
# 基础 + CONFIG_GDB_STUB。stub 符号实名 = S1 R3 合入态；RSP 走 oh-my-oslab
# gdb carrier 18010。
CONFIG_OPT := -Og
CONFIG_OS := threadx
CONFIG_TX_TICKS_PER_SECOND := 1000
CONFIG_TX_TIMER_STACK := 4096
CONFIG_TX_MAX_THREADS := 16
CONFIG_HEAP_BYTES := 0x400000
CONFIG_GDB_STUB := y
# S4 cherrysh (specs/cherrysh-adapt/SPEC.md): shell + RX 中断与 gdb 会话仲裁共存
CONFIG_SHELL := y
CONFIG_SHELL_STACK := 4096
CONFIG_UART_RX_IRQ := y
