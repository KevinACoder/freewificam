# S5a W5 lwip-wlan 配置 (specs/rtl8821cu-vendor-driver/SPEC.md §4/W5):
# wlan8821.config 基础上把 lwIP 栈与 netutils 工具面带进镜像，**不挂 GMAC**
# —— KI-027 单网卡形态：无线是产品里唯一的 netif（empty CONFIG_GMAC_PORT
# 使 Makefile 把 GMAC 三件套 + ethnetif 整组排除）。
# 命名注记：spec 原文写作 wlan-rtl8821cu-lwip.config，批准计划定名
# lwip-wlan.config（[S5a] 修订注记随 W5 台账留痕）。
# W6 吞吐（N7 R6 已证：-Og->-O2 TX +22.5%）：数据面镜像用 -O2
CONFIG_OPT := -O2
CONFIG_OS := threadx
CONFIG_TX_TICKS_PER_SECOND := 1000
CONFIG_TX_TIMER_STACK := 4096
# vendor 线 + linuxkpi worker + shell + lwip tcpip 线程族
CONFIG_TX_MAX_THREADS := 24
# skb 池 + 线程栈 + lwip heap(1MB) 叠加：堆 8MB 与本线 W1-W4 相同
CONFIG_HEAP_BYTES := 0x800000
CONFIG_SHELL := y
CONFIG_SHELL_STACK := 16384
CONFIG_UART_RX_IRQ := y
CONFIG_USBHOST := y
CONFIG_USBHOST_XHCI := y
CONFIG_USBHOST_XHCI_START_NUM := 2
CONFIG_LINUXKPI := y
CONFIG_LINUXKPI_UDISK := n
CONFIG_LINUXKPI_USB_RX_ASYNC := y
CONFIG_LINUXKPI_STAGE_SMALL_N := 18
CONFIG_NIC_RTL8821CU := y

# S7a/P7a-3 + S5a-W4: wpa_supplicant 组件（A 案认证面）
CONFIG_WPA_SUPPLICANT := y
CONFIG_WPA_BACKEND := vendor
CONFIG_WPA_L2 := direct
CONFIG_WPA_THREAD_STACK := 65536
CONFIG_WPA_SUPP_DEBUG_LEVEL := 2
CONFIG_LIBC_COMPLETION := y

# W5 数据面：lwIP + wlan netif 桥 + netutils(ping/tftp/iperf3)
CONFIG_LWIP := y
# 留空 = 无 GMAC（KI-027 单网卡；GMAC 三件套+ethnetif 不编）
CONFIG_GMAC_PORT :=
CONFIG_WLAN_NETIF := y
CONFIG_NETUTILS := y
CONFIG_NETUTILS_PING := y
CONFIG_NETUTILS_TFTP := y
CONFIG_NETUTILS_IPERF3 := y
CONFIG_NETUTILS_IPERF2 := y
# W6 吞吐：CPU 升频 1800MHz（N7 R5a 板证链，vk 内置表 1.8GHz/1.15V）
CONFIG_CPU_BOOST_MHZ := 1800
