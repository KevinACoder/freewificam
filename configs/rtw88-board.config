# S9/W2 rtw88 板级 bring-up (specs/rtw88-adapt/SPEC.md §4/W2):
# rtw88-build 形态 + 认领链上板——modeswitch(1a2b 弹盘) + wlan 钩(c820)
# + rtw88_probe + fw registry + register_hw/ops->start 锚点。
# 8821cu 插 xHCI 直插口 (fd000000, GT 轮同口位)。
CONFIG_OPT := -Og
CONFIG_OS := threadx
CONFIG_TX_TICKS_PER_SECOND := 1000
CONFIG_TX_TIMER_STACK := 4096
CONFIG_TX_MAX_THREADS := 16
CONFIG_HEAP_BYTES := 0x400000
CONFIG_SHELL := y
CONFIG_SHELL_STACK := 4096
CONFIG_UART_RX_IRQ := y
CONFIG_USBHOST := y
CONFIG_USBHOST_XHCI := y
CONFIG_USBHOST_XHCI_START_NUM := 2
CONFIG_LINUXKPI := y
CONFIG_LINUXKPI_80211 := y
CONFIG_NIC_RTW88 := y
