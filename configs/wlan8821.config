# S5a W1 wlan8821 配置 (specs/rtl8821cu-vendor-driver/SPEC.md v2 §4/W1):
# threadx-lkpi 血统 —— USB host (XHCI×2) + linuxkpi vendor 增量档 + shell，
# rtl8821cu vendor 驱动进镜像（CONFIG_NIC_RTL8821CU）。
# 裁剪面（单因素纪律）：
#  - 不编 GMAC/lwip/netutils（W1-W4 无网络栈，KI-027 的镜像侧形态：无双有线、
#    无 lwip 线程面）
#  - 不编 U 盘/hub 验收驱动（CONFIG_LINUXKPI_UDISK=n；linuxkpi 基底 + 认领钩子
#    + usbkpi 照常在）
#  - 不开 CPU_BOOST（N7 线教训：升频实验面与本线无关）
# 命名注记：spec 原文写作 wlan-rtl8821cu.config，批准计划 v2 定名 wlan8821.config
# （[S5a] 修订注记随 R1 台账留痕）。
CONFIG_OPT := -Og
CONFIG_OS := threadx
CONFIG_TX_TICKS_PER_SECOND := 1000
CONFIG_TX_TIMER_STACK := 4096
# vendor 线 + linuxkpi worker + shell：cmd/evt/xmit/recv/mlme 线程族（4）+
# lkpi worker + tx_timer 线程 + shell —— 上限放宽到 24
CONFIG_TX_MAX_THREADS := 24
# skb 池 + 4×8KB 线程栈 + prealloc 接收缓冲：堆从 4MB 放宽到 8MB
CONFIG_HEAP_BYTES := 0x800000
CONFIG_SHELL := y
CONFIG_SHELL_STACK := 4096
CONFIG_UART_RX_IRQ := y
CONFIG_USBHOST := y
CONFIG_USBHOST_XHCI := y
# 双实例：busid 2 = 0xFD000000 直插口（8821cu 靶位），busid 3 = 0xFCC00000
# （P5-b 拓扑继承；wlan 靶直插 bus2，GL hub 口留空）
CONFIG_USBHOST_XHCI_START_NUM := 2
CONFIG_LINUXKPI := y
CONFIG_LINUXKPI_UDISK := n
CONFIG_NIC_RTL8821CU := y
