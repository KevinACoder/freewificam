# S8/S8-1 net80211 协议层编译面 (specs/net80211-adapt/SPEC.md §3.8):
# 基座(threadx) + vendored 协议核心 9 .c + AES 子集 + compat 三件。
# 无 USB、无 wlan 驱动、无 shell —— S8-1 是纯编译面轮, 判据走 nm 与
# 反向检查, 不上板。
CONFIG_OPT := -Og
CONFIG_OS := threadx
CONFIG_TX_TICKS_PER_SECOND := 1000
CONFIG_TX_TIMER_STACK := 4096
CONFIG_TX_MAX_THREADS := 16
CONFIG_HEAP_BYTES := 0x400000
CONFIG_SHELL := n
CONFIG_UART_RX_IRQ := n
CONFIG_NET80211 := y
