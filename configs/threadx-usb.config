# P5-a cherryusb xHCI 配置 (specs/cherryusb-xhci-port/SPEC.md v2.3 §4/P5-a):
# threadx-mmu 全量 + CherryUSB host 栈 (仅 xHCI 单实例, EHCI 零参与 N4).
# 基于 configs/threadx-mmu.config 的键集; USB 键见根 Makefile USB 块.
CONFIG_OPT := -Og
CONFIG_OS := threadx
CONFIG_TX_TICKS_PER_SECOND := 1000
CONFIG_TX_TIMER_STACK := 4096
CONFIG_TX_MAX_THREADS := 16
CONFIG_HEAP_BYTES := 0x400000
CONFIG_SHELL := y
CONFIG_SHELL_STACK := 4096
CONFIG_UART_RX_IRQ := y
# CherryUSB host 栈 (S5 §3.3): core+hub+usb_hc_xhci + adapters + 域序列.
CONFIG_USBHOST := y
# xHCI: P5-a 单实例 (busid 2 = 0xFD000000); P5-b 起双实例时
# CONFIG_USBHOST_XHCI_START_NUM 改 2 (域串行, spec §3.2.2).
CONFIG_USBHOST_XHCI := y
CONFIG_USBHOST_XHCI_START_NUM := 1
