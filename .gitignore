build/
# The RTOS build entry lives in a directory that is otherwise build output.
!tests/board/rtos/build/
tests/board/rtos/build/*
!tests/board/rtos/build/Makefile
!tests/board/rtos/build/*.mk
# The build tooling lives in a directory named build; keep it source.
!tools/build/
tools/build/*
!tools/build/*.py
!tools/build/*.mk
!tools/build/*.sh
out/
*.o
*.ko
*.mod
*.mod.c
*.cmd
__pycache__/
*.pyc

# Imported kernelmod build outputs.
*.o
*.ko
*.mod
*.mod.c
*.cmd
components/linuxkpi/fw/

# Kconfig-generated fragments (the .config and autoconf.h are build outputs).
build/kconfig/
**/autoconf.h
**/.config
**/generated/
