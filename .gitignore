# Build outputs
/build/
/dist/
*.o
*.ko
*.a
*.cmd
.tmp_versions/
Module.symvers
modules.order

# The RTOS build entry lives in a directory that is otherwise build output.
!tests/board/rtos/build/
tests/board/rtos/build/*
!tests/board/rtos/build/Makefile
!tests/board/rtos/build/*.mk

# The build tooling lives in a directory named build; keep it source.
!tools/build/
tools/build/*
!tools/build/*.py
!tools/build/*.mk
!tools/build/*.sh

# Kconfig-generated fragments (the .config and autoconf.h are build outputs).
build/kconfig/
**/autoconf.h
**/.config
**/generated/

# Firmware blobs are never published; hash them in the manifest instead.
*.bin
*.ucode

# Editor residue
*.swp
*~
.DS_Store

# Python bytecode.
__pycache__/
*.pyc

# The host bench builds out of tree; its binary and objects are outputs.
tests/host/kpi/build/

# Generated firmware blobs (build products of tools/rtos/fw-blobs.py).
components/liblinux80211/fw/
