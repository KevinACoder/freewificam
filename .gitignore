build/
# The RTOS build entry lives in a directory that is otherwise build output.
!tests/board/rtos/build/
tests/board/rtos/build/*
!tests/board/rtos/build/Makefile
!tests/board/rtos/build/*.mk
# The build tooling lives in a directory named build; keep it source.
!tools/build/
tools/build/*
!tools/build/*.py
!tools/build/*.mk
!tools/build/*.sh
out/
*.o
*.ko
*.mod
*.mod.c
*.cmd
__pycache__/
*.pyc

# Imported kernelmod build outputs.
*.o
*.ko
*.mod
*.mod.c
*.cmd
components/linuxkpi/fw/

# AIC8800 firmware blobs (regenerate with tools/rtos/aic8800-fw-blobs.py;
# digests and provenance in docs/FIRMWARE-NOTICES.md).
wireless-drivers/aic8800/fw/*.bin
wireless-drivers/aic8800/fw/aic8800_fw_blobs.c

# Kconfig-generated fragments (the .config and autoconf.h are build outputs).
build/kconfig/
**/autoconf.h
**/.config
**/generated/

# Publication output of `make.rtos sdk`.
dist/
