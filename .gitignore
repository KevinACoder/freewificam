# Build outputs
/build/
/dist/
*.o
*.ko
*.a
*.cmd
.tmp_versions/
Module.symvers
modules.order

# The RTOS build entry lives in a directory that is otherwise build output.
!tests/board/rtos/build/
tests/board/rtos/build/*
!tests/board/rtos/build/Makefile
!tests/board/rtos/build/*.mk

# The build tooling lives in a directory named build; keep it source.
!tools/build/
tools/build/*
!tools/build/*.py
!tools/build/*.mk
!tools/build/*.sh

# Kconfig-generated fragments (the .config and autoconf.h are build outputs).
build/kconfig/
**/autoconf.h
**/.config
**/generated/

# Vendor firmware images are tracked inputs, not build products: an image has
# no filesystem, so the only copy a clean clone could use is the one in git.
# The generated C arrays beside them are the build products (rules below).
*.bin

# Editor residue
*.swp
*~
.DS_Store

# Python bytecode.
__pycache__/
*.pyc

# The host bench builds out of tree; its binary and objects are outputs.
tests/host/kpi/build/

# Generated firmware blobs (build products of tools/rtos/fw-blobs.py).  The
# vendor image and its licence beside them are tracked inputs, not products
# (see components/liblinux80211/fw/PROVENANCE.md); only the C unit is ignored.
components/liblinux80211/fw/*.c

# The vendor firmware images under fw/ are tracked inputs; the *.bin rule above
# is about built images, not these blobs.
!components/liblinux80211/fw/**/*.bin
