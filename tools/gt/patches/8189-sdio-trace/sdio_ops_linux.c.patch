 #include <drv_types.h>
 
+/* ---- GT SDIO geometry trace (observation-only, GPL-2.0-only) -------------
+ *
+ * This block is the GT arm's instrument, not part of the pinned driver: it is
+ * applied to a build copy (tools/gt/patches/8189-sdio-trace) and the module it
+ * produces never supplies the denominator.  It records the commands the
+ * driver issued at the two funnels the vendor owns - the CMD52 register path
+ * (_sd_cmd52_read/_sd_cmd52_write and the raw sd_readXX/sd_writeXX helpers)
+ * and the CMD53 data path (_sd_read/_sd_write) - as kind, address, byte count,
+ * duration and return code, and keeps the last 64.  Aggregates and the ring
+ * are dumped on demand through the sdio_trace_dump module parameter, so the
+ * board script reads them at a phase boundary and nothing prints during the
+ * measured window.
+ */
+#include <linux/ktime.h>
+#include <linux/moduleparam.h>
+
+#define RTW_TR_RING	64
+#define RTW_TR_KINDS	4
+
+static const char * const rtw_tr_kind_name[RTW_TR_KINDS] = {
+	"c52r", "c52w", "ext_r", "ext_w"
+};
+
+struct rtw_tr_cnt {
+	u64	n;
+	u64	bytes;
+	u64	sum_us;
+	u32	max_us;
+};
+
+struct rtw_tr_op {
+	u32	seq;
+	u32	t0_us;
+	u32	dur_us;
+	u32	addr;
+	u32	bytes;
+	u32	blocks;
+	u8	kind;
+	s8	ret;
+};
+
+static struct rtw_tr_cnt rtw_tr_cnt[RTW_TR_KINDS];
+static struct rtw_tr_op rtw_tr_ring[RTW_TR_RING];
+static u32 rtw_tr_head;
+static int rtw_tr_on = 1;
+static int rtw_tr_dump;
+
+static inline u32 rtw_tr_us(void)
+{
+	return (u32)(ktime_get_ns() / 1000);
+}
+
+static void rtw_tr_note(u8 kind, u32 addr, u32 bytes, u32 blocks, s32 ret, u32 t0)
+{
+	struct rtw_tr_op *op;
+	u32 now = rtw_tr_us();
+	u32 dur = now - t0;
+	u32 seq;
+
+	if (!rtw_tr_on || kind >= RTW_TR_KINDS)
+		return;
+	rtw_tr_cnt[kind].n++;
+	rtw_tr_cnt[kind].bytes += bytes;
+	rtw_tr_cnt[kind].sum_us += dur;
+	if (dur > rtw_tr_cnt[kind].max_us)
+		rtw_tr_cnt[kind].max_us = dur;
+	seq = rtw_tr_head + 1;
+	op = &rtw_tr_ring[rtw_tr_head % RTW_TR_RING];
+	op->seq = 0;
+	op->t0_us = t0;
+	op->dur_us = dur;
+	op->addr = addr;
+	op->bytes = bytes;
+	op->blocks = blocks;
+	op->kind = kind;
+	op->ret = (s8)ret;
+	smp_wmb();
+	op->seq = seq;
+	rtw_tr_head = seq;
+}
+
+static int rtw_tr_dump_set(const char *val, const struct kernel_param *kp)
+{
+	u32 head = rtw_tr_head;
+	unsigned int k, i, n;
+
+	(void)val;
+	(void)kp;
+	pr_info("RTWTR begin on=%d head=%u\n", rtw_tr_on, head);
+	for (k = 0; k < RTW_TR_KINDS; k++) {
+		pr_info("RTWTR GEOM k=%s n=%llu bytes=%llu avg_us=%llu max_us=%u\n",
+			rtw_tr_kind_name[k],
+			(unsigned long long)rtw_tr_cnt[k].n,
+			(unsigned long long)rtw_tr_cnt[k].bytes,
+			rtw_tr_cnt[k].n ?
+				(unsigned long long)(rtw_tr_cnt[k].sum_us /
+					rtw_tr_cnt[k].n) : 0ULL,
+			rtw_tr_cnt[k].max_us);
+	}
+	n = (head < RTW_TR_RING) ? head : RTW_TR_RING;
+	for (i = 0; i < n; i++) {
+		/* Absolute write index of the entry: the ring holds the writes
+		 * head-n .. head-1, and write h stored seq h+1 at slot h%RING. */
+		u32 at = head - n + i;
+		struct rtw_tr_op *op = &rtw_tr_ring[at % RTW_TR_RING];
+
+		if (op->seq == 0 || op->seq != at + 1)
+			continue;
+		pr_info("RTWTR OP t=%u dur=%u k=%u addr=%05x bytes=%u blk=%u ret=%d\n",
+			op->t0_us, op->dur_us, op->kind, op->addr, op->bytes,
+			op->blocks, op->ret);
+	}
+	pr_info("RTWTR end\n");
+	return 0;
+}
+
+static const struct kernel_param_ops rtw_tr_dump_ops = {
+	.set = rtw_tr_dump_set,
+	.get = param_get_int,
+};
+
+module_param_named(sdio_trace, rtw_tr_on, int, 0644);
+module_param_cb(sdio_trace_dump, &rtw_tr_dump_ops, &rtw_tr_dump, 0644);
+/* ---- end of the GT SDIO geometry trace ---------------------------------- */
