diff --git a/phl/hal_g6/mac/mac_ax/ser.c b/phl/hal_g6/mac/mac_ax/ser.c
index cef425b..8a7c65e 100644
--- a/phl/hal_g6/mac/mac_ax/ser.c
+++ b/phl/hal_g6/mac/mac_ax/ser.c
@@ -395,10 +395,16 @@ u32 mac_dump_err_status(struct mac_ax_adapter *adapter,
 		    err == MAC_AX_ERR_L0_PROMOTE_TO_L1_DBG)
 			mac_dump_l0_to_l1(adapter, err);
 	}
-	if (err == MAC_AX_ERR_L0_ERR_CMAC0 ||
+	/* [S5b-W3 print-clean] The walkers below (per-4B DMAC/CMAC CR walks,
+	 * ss/dle dbgpkg, full dbg-port loop, whole share-mem dump) flood the
+	 * RTOS serial ~35s and evict the incident window from the ring buffer.
+	 * Gated behind ser dbg_lvl bit5 (dbgprt_dump), default 0; re-enable at
+	 * runtime via `set_ser_log_lvl` / MAC_AX_HW_SET_SER_DBG_LVL. */
+	if (adapter->ser_info.dbg_lvl.dbgprt_dump &&
+	    (err == MAC_AX_ERR_L0_ERR_CMAC0 ||
 	    err == MAC_AX_ERR_L0_ERR_CMAC1 ||
 	    err == HALT_C2H_L1_DBG_MODE ||
-	    err == MAC_AX_ERR_L0_PROMOTE_TO_L1_DBG) {
+	    err == MAC_AX_ERR_L0_PROMOTE_TO_L1_DBG)) {
 		cmac_err = MAC_REG_R32(R_AX_CMAC_ERR_ISR);
 		dmac_err = MAC_REG_R32(R_AX_DMAC_ERR_ISR);
 		dump_dmac_cr(adapter);
