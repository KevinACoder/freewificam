diff --git a/os_dep/linux/os_intfs.c b/os_dep/linux/os_intfs.c
index 58911ea..9380761 100755
--- a/os_dep/linux/os_intfs.c
+++ b/os_dep/linux/os_intfs.c
@@ -21,6 +21,18 @@ MODULE_DESCRIPTION("Realtek Wireless Lan Driver");
 MODULE_AUTHOR("Realtek Semiconductor Corp.");
 MODULE_VERSION(DRIVERVERSION);
 
+/* [W1-0002] rtw_ioctl link stub ([FWC] 0002 lineage): ioctl_linux.c is not in
+ * the RTOS compile set (spec §3.3 compile-face lock), but net_device_ops /
+ * rtw_siocdevprivate in this file reference rtw_ioctl (os_intfs.c:215/218/
+ * 340/356/386). The stub keeps the link closed, matching the [S5a] W1 shape. */
+int rtw_ioctl(struct net_device *dev, struct ifreq *rq, int cmd)
+{
+	(void)dev;
+	(void)rq;
+	(void)cmd;
+	return -EOPNOTSUPP;
+}
+
 
 int netdev_open(struct net_device *pnetdev);
 static int netdev_close(struct net_device *pnetdev);
diff --git a/os_dep/linux/usb_intf.c b/os_dep/linux/usb_intf.c
index 3752512..8a0c8f7 100755
--- a/os_dep/linux/usb_intf.c
+++ b/os_dep/linux/usb_intf.c
@@ -1110,3 +1110,18 @@ static void __exit rtw_drv_halt(void)
 
 module_init(rtw_drv_entry);
 module_exit(rtw_drv_halt);
+
+/* [W1-0002] Export shells for the RTOS consumer build ([FWC] 0002 lineage):
+ * module_init/module_exit are no-op'd by linuxkpi, so the adapter attach
+ * path calls rtl8851bu_rtos_init() explicitly - drv_registered handling,
+ * usb_register and the init sequence stay identical to the Linux
+ * module-load path. */
+int rtl8851bu_rtos_init(void)
+{
+	return rtw_drv_entry();
+}
+
+void rtl8851bu_rtos_deinit(void)
+{
+	rtw_drv_halt();
+}
diff --git a/os_dep/osdep_service.c b/os_dep/osdep_service.c
index 046b63c..6ee5004 100644
--- a/os_dep/osdep_service.c
+++ b/os_dep/osdep_service.c
@@ -24,6 +24,15 @@ inline int _rtw_netif_rx(_nic_hdl ndev, struct sk_buff *skb)
 	rtw_hwsim_medium_pre_netif_rx(skb);
 	return netif_rx(skb);
 }
+#else /* [W1-0002] RTOS data seam: with CONFIG_HWSIM off (the default) the
+ * vendor defines _rtw_netif_rx nowhere and the default-config link breaks
+ * (this block is the only definition site). Direct netif_rx pass-through
+ * keeps the data seam landing first-party (spec §3.2.2 V5 diff item 2). */
+inline int _rtw_netif_rx(_nic_hdl ndev, struct sk_buff *skb)
+{
+	skb->dev = ndev;
+	return netif_rx(skb);
+}
 #endif /* CONFIG_HWSIM */
 
 u32 rtw_atoi(u8 *s)
