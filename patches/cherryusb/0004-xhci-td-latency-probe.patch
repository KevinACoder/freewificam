--- a/port/xhci/usb_hc_xhci.c
+++ b/port/xhci/usb_hc_xhci.c
@@ -108,6 +108,21 @@
 
 #define TRB_MAX_BUFF_SIZE	0x10000U /* one TRB must not cross 64KB */
 
+/* P5-e temporary probe (patch 0004): per-TD doorbell->event latency,
+ * cntvct_el0 at 24 MHz, dumped by `usbh stall`.  Splits "fixed per-TD
+ * turnaround" from "per-microframe throttling". */
+static uint32_t g_probe_t0[8][16];
+static uint32_t g_probe_sum[8][16];
+static uint32_t g_probe_max[8][16];
+static uint32_t g_probe_n[8][16];
+
+static inline uint32_t xhci_probe_now(void)
+{
+	uint32_t v;
+
+	__asm__ __volatile__("mrs %0, cntvct_el0" : "=r"(v));
+	return v;
+}
 
 #define USB2_DIR_IN		0x80U
 #define USB2_EP_NUM_MASK	0x0FU
