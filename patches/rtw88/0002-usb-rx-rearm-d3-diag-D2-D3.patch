@@ -592,24 +672,39 @@
 	ep = qsel_to_ep(rtwusb, pkt_info->qsel);
 	rtw_tx_fill_tx_desc(rtwdev, pkt_info, skb);
 	rtw_tx_fill_txdesc_checksum(rtwdev, pkt_info, skb->data);
-	{
-		/* [S9-R3] GT probe: single-line AUTH TXDESC dump, same point
-		 * and format as the RTOS port (post fill+checksum) */
-		static unsigned int d3_auth_dump_cnt;
-
-		if (pkt_info->qsel == TX_DESC_QSEL_MGMT &&
-		    (skb->data[chip->tx_pkt_desc_sz] & 0xfc) == 0xb0 &&
-		    d3_auth_dump_cnt < 4u) {
+
+	/* [S9 D-3] archive the FINAL mgmt TXDESC+frame bytes (post
+	 * checksum - exactly what the URB stages); the first AUTH after
+	 * boot dumps its descriptor inline (shell-independent - the
+	 * console RX dies under the retry flood).  Lives here, not in
+	 * rtw_usb_write_data: the ordinary auth path never goes through
+	 * write_data (rsvd-page/H2C only - codex audit). */
+	if (pkt_info->qsel == TX_DESC_QSEL_MGMT) {
+		u32 n = (u32)chip->tx_pkt_desc_sz + pkt_info->tx_pkt_size;
+
+		if (n > sizeof(d3_tx_last))
+			n = sizeof(d3_tx_last);
+		memcpy(d3_tx_last, skb->data, n);
+		d3_tx_last_len = n;
+		d3_tx_cap_cnt++;
+		/* [S9 D-3 R3] single-line 48B (12 dwords) descriptor dump:
+		 * the R2 five-line burst never reached the serial ring -
+		 * keep the line <=150 chars so line assembly cannot drop
+		 * it, and never read past the copied bytes (R2 tail
+		 * over-read: nw=n/4 stepping 4 printed d[16..19] for n=78). */
+		if ((skb->data[chip->tx_pkt_desc_sz] & 0xfc) == 0xb0 &&
+		    d3_auth_dump_cnt < 2U) {
 			const __le32 *d = (const __le32 *)skb->data;
 
 			d3_auth_dump_cnt++;
-			rtw_err(rtwdev, "GTD3 AUTH desc %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x %08x\n",
-				le32_to_cpu(d[0]), le32_to_cpu(d[1]),
-				le32_to_cpu(d[2]), le32_to_cpu(d[3]),
-				le32_to_cpu(d[4]), le32_to_cpu(d[5]),
-				le32_to_cpu(d[6]), le32_to_cpu(d[7]),
-				le32_to_cpu(d[8]), le32_to_cpu(d[9]),
-				le32_to_cpu(d[10]), le32_to_cpu(d[11]));
+			printf("rtw88u: d3 AUTH desc %08x %08x %08x %08x "
+			    "%08x %08x %08x %08x %08x %08x %08x %08x\n",
+			    le32_to_cpu(d[0]), le32_to_cpu(d[1]),
+			    le32_to_cpu(d[2]), le32_to_cpu(d[3]),
+			    le32_to_cpu(d[4]), le32_to_cpu(d[5]),
+			    le32_to_cpu(d[6]), le32_to_cpu(d[7]),
+			    le32_to_cpu(d[8]), le32_to_cpu(d[9]),
+			    le32_to_cpu(d[10]), le32_to_cpu(d[11]));
 		}
 	}
 	tx_data = rtw_usb_get_tx_data(skb);
@@ -646,10 +741,12 @@
 		rx_skb = skb_dequeue(&rtwusb->rx_queue);
 		if (!rx_skb)
 			break;
+		d3u_urb++;
 
 		if (skb_queue_len(&rtwusb->rx_queue) >= RTW_USB_MAX_RXQ_LEN) {
 			dev_dbg_ratelimited(rtwdev->dev, "failed to get rx_queue, overflow\n");
 			dev_kfree_skb_any(rx_skb);
+			d3u_rxq_ovf++;
 			continue;
 		}
 
@@ -658,8 +755,10 @@
 		do {
 			ret = rtw_rx_query_rx_desc(rtwdev, rx_desc,
 						   &pkt_stat, &rx_status);
-			if (ret)
+			if (ret) {
+				d3u_query_fail++;
 				break;
+			}
 
 			pkt_offset = pkt_desc_sz + pkt_stat.drv_info_sz +
 				     pkt_stat.shift;
@@ -669,6 +768,7 @@
 				rtw_dbg(rtwdev, RTW_DBG_USB,
 					"skipping too big packet: %u\n",
 					skb_len);
+				d3u_too_big++;
 				goto skip_packet;
 			}
 
@@ -677,14 +777,48 @@
 				rtw_dbg(rtwdev, RTW_DBG_USB,
 					"failed to allocate RX skb of size %u\n",
 					skb_len);
+				d3u_alloc_fail++;
 				goto skip_packet;
 			}
 
 			skb_put_data(skb, rx_desc, skb_len);
 
 			if (pkt_stat.is_c2h) {
+				d3u_c2h++;
 				rtw_fw_c2h_cmd_rx_irqsafe(rtwdev, pkt_offset, skb);
 			} else {
+				/* D-3 chip-DMA truth: classify off the
+				 * descriptor payload before anything
+				 * downstream can drop it */
+				d3u_pkt++;
+				if (pkt_stat.hdr != NULL) {
+					u16 fc = le16_to_cpu(pkt_stat.hdr->frame_control);
+
+					if ((fc & 0x0c) == 0) {	/* mgmt */
+						d3u_mgmt++;
+						if ((pkt_stat.hdr->addr1[0] & 0x01) == 0) {
+							d3u_mgmt_uni++;
+							d3u_uni_print(&pkt_stat);
+						}
+						/* [S9 D-3] EXACT da==us counter: the
+						 * uni counter above counts every
+						 * unicast mgmt regardless of the
+						 * destination (codex audit); this one
+						 * answers "did anything arrive
+						 * addressed to our MAC" precisely. */
+						if (d3_da_set &&
+						    memcmp(pkt_stat.hdr->addr1, d3_da, 6) == 0) {
+							d3u_mgmt_da++;
+							if (d3u_mgmt_da <= 8U)
+								printf("rtw88u: d3 chip-rx DA-US! "
+								    "fc=%04x rate=%u len=%u ta=%02x:%02x:%02x:%02x:%02x:%02x\n",
+								    fc, pkt_stat.rate, pkt_stat.pkt_len,
+								    pkt_stat.hdr->addr2[0], pkt_stat.hdr->addr2[1],
+								    pkt_stat.hdr->addr2[2], pkt_stat.hdr->addr2[3],
+								    pkt_stat.hdr->addr2[4], pkt_stat.hdr->addr2[5]);
+						}
+					}
+				}
 				skb_pull(skb, pkt_offset);
 				rtw_update_rx_freq_for_invalid(rtwdev, skb,
 							       &rx_status,
@@ -858,6 +992,23 @@
 
 static int rtw_usb_start(struct rtw_dev *rtwdev)
 {
+	struct rtw_usb *rtwusb = rtw_get_usb_priv(rtwdev);
+	int i;
+
+	/* [S9 D-2] the rx urbs armed at probe end ride their first TD
+	 * across the chip's power-off/on cycle (the efuse read leaves
+	 * the chip off; rtw_power_on re-inits it here).  On the RTOS
+	 * xHCI that old TD never completes afterwards (the ring shows
+	 * it armed, the endpoint running, zero transfers - board
+	 * 2026-10-04), while the vendor line arms its rx urbs after
+	 * chip init and receives fine.  Re-arm the queue here so every
+	 * resident TD belongs to the running chip generation. */
+	rtw_usb_cancel_rx_bufs(rtwusb);
+	for (i = 0; i < RTW_USB_RXCB_NUM; i++) {
+		struct rx_usb_ctrl_block *rxcb = &rtwusb->rx_cb[i];
+
+		rtw_usb_rx_resubmit(rtwusb, rxcb, GFP_KERNEL);
+	}
 	return 0;
 }
 
