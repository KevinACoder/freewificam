@@ -22,10 +22,65 @@
 
 #define RTW_USB_MAX_RXQ_LEN	512
 
+/* D-3 diagnostics (DIVERGENCES.md D-3, removal = 单播 RX 断链结案):
+ * chip->host DMA truth.  The bridge sees beacons but never a unicast
+ * mgmt frame; these counters decide whether the chip ever put one on
+ * the wire to us (parsed straight off the RX descriptor payload,
+ * before any queue/alloc drop can hide it). */
+static u32 d3u_urb, d3u_pkt, d3u_c2h, d3u_mgmt, d3u_mgmt_uni,
+	   d3u_mgmt_da, d3u_rxq_ovf, d3u_query_fail, d3u_too_big, d3u_alloc_fail;
+
+static void d3u_uni_print(const struct rtw_rx_pkt_stat *ps)
+{
+	const struct ieee80211_hdr *h = ps->hdr;
+	u16 fc = le16_to_cpu(h->frame_control);
+
+	if (d3u_mgmt_uni <= 8U)
+		printf("rtw88u: d3 chip-rx uni-mgmt fc=%04x st=%u "
+		    "da=%02x:%02x:%02x:%02x:%02x:%02x rate=%u len=%u\n",
+		    fc, (fc >> 4) & 0xf,
+		    h->addr1[0], h->addr1[1], h->addr1[2],
+		    h->addr1[3], h->addr1[4], h->addr1[5],
+		    ps->rate, ps->pkt_len);
+}
+
+/* [S9 D-3] mgmt TX archive: the final TXDESC+frame bytes of the last
+ * mgmt urb (post fill_txdesc+checksum, exactly what the URB carries),
+ * kept so the shell can re-dump them after a console scroll.  The
+ * first two frames after a reset also print inline. */
+static u8 d3_tx_last[512];
+static u32 d3_tx_last_len, d3_tx_cap_cnt, d3_tx_hex_cnt, d3_auth_dump_cnt;
+
+/* [S9 D-3 R3] TX pipeline junction ledger (console-independent truth):
+ * ops_tx calls / ops_tx mgmt / RUNNING-gate drops / rtw_tx mgmt / usb
+ * mgmt (=d3_tx_cap_cnt above).  Expected chain for N auth attempts:
+ * ops_mgmt >= hci_mgmt >= cap; a break names the silent-drop stage
+ * (R2: the auth TXDESC dumps never printed and neither did the ops_tx
+ * regs snapshot - either a pre-USB silent drop or serial loss; these
+ * counters settle it without trusting the console). */
+u32 rtw_d3_tx_ops, rtw_d3_tx_ops_mgmt, rtw_d3_tx_dropped, rtw_d3_tx_hci_mgmt;
+
+/* [S9 D-3] exact destination counter state (set from add_interface) */
+static u8 d3_da[6];
+static int d3_da_set;
+
+void rtw_d3_set_da(const u8 *mac)
+{
+	memcpy(d3_da, mac, 6);
+	d3_da_set = 1;
+}
+
 struct rtw_usb_txcb {
 	struct rtw_dev *rtwdev;
 	struct sk_buff_head tx_ack_queue;
+	/* [S9 D-3 R3] double-completion trap (C1): the HC can deliver the
+	 * same urb twice (shim has a history of it); a second completion
+	 * on a freed txcb would dequeue garbage.  Magic + per-txcb done
+	 * counter make that audible before the heap dies. */
+	u32 magic;
+	u32 done_cnt;
 };
+#define RTW_USB_TXCB_MAGIC	0x7acb0000U
 
 static void rtw_usb_fill_tx_checksum(struct rtw_usb *rtwusb,
 				     struct sk_buff *skb, int agg_num)
@@ -319,8 +374,24 @@
