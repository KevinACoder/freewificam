+	if (rtw_d3_cmp_sticky && rtwdev != NULL) {
+		mutex_lock(&rtwdev->mutex);
+		rtw_d3_cmp_write_locked(d3_cmp_m2);
+		mutex_unlock(&rtwdev->mutex);
+	}
