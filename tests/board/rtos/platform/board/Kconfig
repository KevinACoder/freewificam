# Board and bus selection, and the board-side diagnostic levers.
#
# The board choice feeds BOARD in the build Makefile (platform source set,
# include flavours, link script, entry gate).  The three names are the three
# lab boards the image can target; rk3568-itx is the default.

menu "Board and bus"

choice BOARD
	prompt "Board"
	default BOARD_RK3568_ITX

config BOARD_RK3568_ITX
	bool "RK3568 E4AP5G1-ITX"

config BOARD_STM32F429_CHALLENGER
	bool "STM32F429 挑战者 V2 (FreeRTOS CM4F)"

endchoice

# --- STM32F429 memory map (2026-11-15) -------------------------------------
#
# The 挑战者 V2 core board carries a 32 MB W9825G6 on FMC SDRAM bank 2
# (0xD0000000).  The wireless images put the FreeRTOS heap and the lwIP heap
# there, because mac80211's working set (RX skbs, driver records, wiphy/BSS
# tables) cannot fit in the 192 KB SRAM next to the DMA-visible static
# buffers.  The SDRAM is brought up from main() after the console and before
# the first allocation; a failure has to be spoken, not faulted on.

config F429_SDRAM
	bool "FMC SDRAM (32 MB W9825G6 on the core board)"
	depends on BOARD_STM32F429_CHALLENGER
	help
	  Initialises the FMC SDRAM bank 2 from main() and runs the bounded
	  self-test (three 64 KiB windows, address uniqueness, 8/16-bit
	  accesses).  Off: the core board's SDRAM is never touched.

config F429_HEAP_SDRAM
	bool "Place the FreeRTOS heap in SDRAM"
	depends on F429_SDRAM
	help
	  ucHeap moves to the .sdram.heap section (NOLOAD) and heap_4 is told
	  the application supplies the array.  The heap size is
	  CONFIG_FREERTOS_HEAP_SIZE; the wireless profiles give it 4 MiB.

config F429_SDIO_AP6181
	bool "Power the onboard AP6181 (BCM43362) on the SDIO socket"
	depends on BOARD_STM32F429_CHALLENGER
	help
	  The 挑战者 V2 carries an AP6181 (BCM43362) on the same SDIO pins the
	  TF socket uses.  With this on, the socket bring-up drives PB13
	  (WL_REG_ON / WIFI_EN) high and gives the module its settle before
	  the host programs the card clock.  Off holds PB13 low, which is the
	  8189FTV and the plain-SD-card state: the module must stay off the
	  shared bus.  The TF socket must be empty in either case.

config F429_WIFI_STAGE
	int "F429 8188EUS ladder stage (3 attach, 4 scan, 5 join, 6 throughput)"
	depends on BOARD_STM32F429_CHALLENGER
	range 3 6
	default 3
	help
	  The f429_wifi case stops after this layer; the four
	  stm32f429-wifi-c{3,4,5,6} profiles set it.  It is a ladder switch,
	  not a tuning knob: each stage's anchors are the evidence for that
	  layer.

config F429_LWIP_SDRAM
	bool "Place lwIP's heap and memp pools in the FMC SDRAM"
	depends on F429_SDRAM && LIBLINUX80211_NET_LWIP
	help
	  The 192 KB of internal SRAM cannot hold the RK-sized lwIP pools
	  (1 MB heap, 448 x 1600 B pbufs).  With this on, lwipopts.h takes
	  its F429 branch: MEM_SIZE fits the linker's .sdram.lwip reserve,
	  MEMP_MEM_MALLOC moves every memp pool onto that heap, and
	  LWIP_RAM_HEAP_POINTER points at the reserve (the board glue
	  exports lkpi_lwip_heap_ptr).  The data path still copies into the
	  driver's SRAM skbs, so no lwIP buffer is ever DMA'd from SDRAM.

config F429_TICK_PC
	bool "F429 diagnostic: print the tick-interrupted PC every 500 ticks"
	depends on BOARD_STM32F429_CHALLENGER
	help
	  Turns the tick hook into a PC sampler on the polled UART (no console
	  lock): a wedged loop with interrupts on keeps naming its PC, a loop
	  with interrupts masked stops printing.  Diagnostic only.

config F429_WIFI_TP
	bool "F429 wifi: run the throughput phases after the data plane pings"
	depends on F429_WIFI_STAGE = 6
	help
	  Turns the four report-only phases on (tcp down/up, udp down/up).
	  Each phase waits for its peer inside its own window; a missing
	  peer is recorded as done=0, never as a pass.  No 80% gate here.

config F429_WIFI_AP_TP
	bool "F429 wifi AP: run the four report-only throughput phases"
	depends on BOARD_STM32F429_CHALLENGER
	help
	  Turns the four report-only AP phases on (the board sends TCP and
	  receives TCP, receives UDP and sends UDP, against the bench's iperf2
	  and counting-sink arms).  Each phase waits for its peer inside its own
	  window; a missing peer is recorded as ok=0 and bytes=0, never as a
	  pass.  There is no throughput gate here: the numbers are samples of
	  one window on this bench, and this board's host is full-speed USB.

config USB_MSC_DIAG
	bool "USB mass-storage diagnostics"

config USB_MSC_DIAG_FULL
	bool "USB mass-storage full diagnostics"

# The GMAC per-frame tuning/instrument levers.  These were only ever -D
# tokens carried by CONFIG_LEVERS; they are modeled here so a profile can be
# read and diffed, but the generator renders them through CFG_DEFS only (no
# make variable is consumed by the build).
config GMAC_RX_BATCH
	bool "GMAC RX batch"

config GMAC_RX_BH
	bool "GMAC RX bottom half"

config GMAC_RX_HWCSUM
	bool "GMAC RX hardware checksum"

config GMAC_RX_ZC
	bool "GMAC RX zero copy"

config GMAC_STALL_PROBE
	bool "GMAC stall probe"

config GMAC_SWEEP_WIDE
	bool "GMAC wide sweep"

config GMAC_TCP_PROBE
	bool "GMAC TCP probe"

config GMAC_TX_CSUM
	bool "GMAC TX checksum"

config GMAC_TX_RING
	int "GMAC TX ring descriptors"
	default 256

config GMAC_TX_SWEEP_GUARD
	bool "GMAC TX sweep guard"

config GMAC_TX_TAIL_IDLE
	bool "GMAC TX tail idle"

endmenu
