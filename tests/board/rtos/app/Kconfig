# The application's own configuration.
#
# The previous tree carried the wireless-bench and netio instrument knobs here
# (WLAN_*, NETIO_*, the lwIP window knobs).  This line imports neither, so the
# menu keeps the one symbol every image needs - the case list - and the place
# for a knob a future case brings with it.

menu "Application"

config CASES
	string "Case groups (space-separated)"
	default ""
	help
	  The case groups this image carries, in run order.  Each name is one
	  translation unit under app/cases/ and one entry in the runner's table;
	  the build derives the case's RTOS_CASE_* macro from this string, so the
	  source set, the table and the judge's expectations are the same fact.

config AP_WPA2
	bool "iwl7260_ap runs the WPA2-PSK/CCMP variant"
	help
	  Only changes the AP case (and the hostapd configuration it applies):
	  the passphrase, the 4-way wait and the PASS APW gate.  The hostap
	  source set, the driver table and the image's other cases are the same
	  as the open AP profile.  Used by rk3568-iwl7260-ap-wpa2.

config AP_FREQ
	int "iwl7260_ap5g operating frequency (MHz)"
	default 5180
	range 2400 6000
	help
	  The 5 GHz round's channel, given as the frequency so that the band and
	  the hostapd hw_mode cannot disagree: the case derives the channel
	  number from it and picks hw_mode from the band, and a profile whose
	  frequency is not beaconable falls back to the fixed candidate order
	  with a note rather than starting on the wrong channel.

config AP_HW_MODE
	string "iwl7260_ap5g hostapd hw_mode (a for 5 GHz, g for 2.4)"
	default "a"

config AP_DIAG
	bool "iwl7260_ap runs the A4 stall diagnostic variant"
	help
	  Replaces the throughput table with the A4 diagnosis: the A3 pings,
	  a post-ping probe, short UDP windows, a 1 s interrupt-freeze detector,
	  NAPI/MMIO/CSR snapshots and the pre-registered verdict line.  The
	  normal AP profiles leave this off; used by rk3568-iwl7260-ap-a4.

config AP_DIAG_IDLE
	bool "the A4 diagnostic idles the AP instead of using the peer"
	depends on AP_DIAG
	help
	  Skips the station wait and the pings: the AP is started and left
	  alone for 60 s while the interrupt-delivery delta is recorded.  This
	  is the no-peer baseline for the traffic arm, not a stall test.
	  Used by rk3568-iwl7260-ap-a4-idle.

config AP_DIAG_TABLE
	bool "the A4 diagnostic runs the standard phase table with probes"
	depends on AP_DIAG
	help
	  Keeps the original round's exact seven-phase sequence and adds the
	  diagnostic probe at every phase boundary, so a freeze lands on a
	  named phase.  This is the faithful-reproduction arm; used by
	  rk3568-iwl7260-ap-a4-table.

# --- the 8189FTV AP role (docs/HANDOFF-8189FTV-RTOS-AP.md) ----------------
#
# The AP is the vendor stack's own MLME; these three symbols only choose which
# arm of the round the image is.  The SSID/channel/frequency live in the case
# (they are the pre-registered constants), not in Kconfig, so two profiles of
# the same arm cannot silently disagree about what went on the air.

config RTL8189FS_AP_TP
	bool "rtl8189fs_ap runs the A4 phase table (throughput verdict image)"
	help
	  Off: the case stops after A3 (A1-A3 functional verdict).  On: after
	  the same bring-up and pings it runs the AP phase table and prints
	  PASS APT.  A throughput verdict and a functional verdict must not
	  share an image; used by rk3568-rtl8189fs-ap-tp.

config RTL8189FS_AP_WPA2
	bool "rtl8189fs_ap runs the WPA2-PSK/CCMP variant"
	help
	  The same AP with hostapd configured WPA2-PSK/CCMP and the case
	  stopping after A3 (the handshake gate).  Used by
	  rk3568-rtl8189fs-ap-wpa2.  The bench passphrase is not a secret.

config RTL8189FS_AP_PSK
	string "rtl8189fs_ap WPA2 passphrase"
	default "rtos-8189-wpa2-psk"

config STA_SSID
	string "G2 STA target SSID"
	default ""

config STA_BSSID
	string "G2 STA target BSSID (empty = any)"
	default ""

config STA_FREQ
	int "G2 STA target frequency (MHz, 0 = any)"
	default 2432

config STA_DHCP
	bool "G2 STA uses DHCP (otherwise the static address below)"
	default n

config STA_STATIC_IP
	string "G2 STA static address"
	default ""

config STA_STATIC_MASK
	string "G2 STA static netmask"
	default "255.255.255.0"

config STA_STATIC_GW
	string "G2 STA static gateway"
	default ""

config STA_FALLBACK_IP
	string "G2 STA static fallback address when DHCP times out"
	default "192.168.3.200"

config STA_FALLBACK_GW
	string "G2 STA static fallback gateway"
	default "192.168.3.1"

config STA_PEER_CANDIDATES
	string "G2 STA peer candidates, space separated"
	default ""

config C6_PEER_IP
	string "C6 throughput peer address"
	default "192.168.99.1"

config MON_FREQ
	int "iwl7260_mon monitor channel frequency (MHz)"
	default 2432
	range 2400 6000
	help
	  The monitor round's channel (docs/HANDOFF-AC7260-MONITOR.md).  It is
	  the bench AP's channel, so the monitor sits on the channel the frames
	  are on; the GT arm sets `iw dev wlan0 set channel` to the same one.

config MON_WINDOW_MS
	int "iwl7260_mon capture window (ms)"
	default 15000
	range 1000 600000
	help
	  The window the case counts in.  It is the GT arm's tcpdump window
	  (`MON_SECONDS * 1000`), so the two arms' beacon rates are comparable
	  without a rescaling step.

config STA_PSK
	string "G2 STA passphrase when it is a non-secret bench constant"
	default "rtos-7260-wpa2-psk"

config MON_FREQ
	int "iwl7260_mon monitor channel frequency (MHz)"
	default 2432
	range 2400 6000
	help
	  The monitor round's channel (docs/HANDOFF-AC7260-MONITOR.md).  It is
	  the bench AP's channel, so the monitor sits on the channel the frames
	  are on; the GT arm sets `iw dev wlan0 set channel` to the same one.

config MON_WINDOW_MS
	int "iwl7260_mon capture window (ms)"
	default 15000
	range 1000 600000
	help
	  The window the case counts in.  It is the GT arm's tcpdump window
	  (`MON_SECONDS * 1000`), so the two arms' beacon rates are comparable
	  without a rescaling step.

config STA_PSK_EXTERNAL
	bool "G2 STA passphrase comes from generated sta_psk.h"
	default n
	help
	  The QiQiJia passphrase must not enter the repository.  The profile
	  selects this and tools/rtos/sta-psk.py writes build/kconfig/<profile>/
	  sta_psk.h (gitignored, 0600) from the STA_PSK environment.  The Pi
	  bench profile may use its non-secret bench constant instead.

# --- the station cases' own window (docs/HANDOFF-8189FTV-STA-RX.md) --------
#
# The AP->board arm is driven from the host on the case's own anchor, so the
# window has to be long enough for the bench's ping and long enough to record
# what arrived.  A 6 s window with a 10 s ping measures the reset, not the
# link (2026-11-13: the open arm's 4/30 was that arithmetic, the WPA2 arm's
# capture ended before its hold).  Both numbers are Kconfig so a profile can
# say which window it measured in, and the case prints them in its anchors.

config STA_WINDOW_MS
	int "STA peer window (ms) the AP->board arm runs inside"
	default 6000
	range 1000 600000
	help
	  The window between the station's own bring-up and its own ping rounds.
	  The host fires the AP->board ping (and the neighbour-state probes) on
	  the `peer window ms=` anchor.  rk3568-rtl8189fs-sta-long raises it to
	  60000 so both ICMP sizes fit with the neighbour state sampled before
	  and after.

config STA_HOLD_MS
	int "STA post-verdict hold (ms): the link stays up for the reverse arm"
	default 0
	range 0 600000
	help
	  After the verdict lines the case holds the link for this long, which is
	  the only way the host's AP->board arm overlaps a board that is still
	  alive (the runner resets the board once the case returns).  The station
	  images before 2026-11-13 measured the reverse arm outside any captured
	  window; the long profiles hold 30 s and the case ends with an `end`
	  anchor the capture runs to.

# --- rtw89 (RTL8851BU, USB) ------------------------------------------------
#
# The controller family is a bench fact, not a runtime guess: the dongle is a
# USB2 part, and which root it hangs on depends on the bench's cabling.  The
# case prints the list it tried and the bus that attached, so a wrong profile
# reads as "no controller" with the list beside it instead of a silent timeout.

config RTW89_C5_PEER_WINDOW_MS
	int "rtw89 C5 peer-arm window (ms)"
	default 6000
	range 1000 30000
	help
	  How long the C5 case holds the link idle for the host's AP->board
	  arm (neighbour lookup, two 20-packet ICMP rounds, the AP's station
	  dump).  6000 ms is what the iwl7260 C5 arm uses; this bench's
	  round takes about 8 s, so the rtw89 profile sets 12000.  Too short a
	  window makes the last packets land after the case's own ping and the
	  arm measures contention, not the receive path.

config RTW89_USB_BUS
	int "rtw89 USB controller family (0 = xHCI roots 3,2; 1 = EHCI roots 1,0)"
	default 0
	range 0 1
	help
	  The two controller lists available on this board.  0 (the default) is
	  the USB3 (DWC3) xHCI pair; the bench's 8851BU hangs on the DWC3 at
	  0xFCC00000 (busid 3), which is what the GT kernel's own topology shows
	  (xhci-hcd.0.auto/usb2/2-1.1, the driver binding interface 1.2).  1 is
	  the USB2 EHCI pair (busids 0/1, 0xFD800000/0xFD880000) and stays as
	  the fallback arm for a port on those roots - a different arm, which a
	  profile changing this must say in its run record.

endmenu
