# F429 wired Ethernet - iperf throughput ladder (measurement tier).
#
# The throughput arm with the measurement tier the wired line uses:
# -O2, 64 pbufs and 32 KiB windows on a 384 KiB lwIP heap (all of it
# in SDRAM).  Everything else matches stm32f429-eth-tput.
# See docs/F429-ETH.md.

CONFIG_ARCH_ARM_V7M=y
CONFIG_BACKEND_FREERTOS=y
CONFIG_OPT_O2=y
CONFIG_DEBUG_G1=y
CONFIG_PROFILE_BASE=y
CONFIG_BOARD_STM32F429_CHALLENGER=y
CONFIG_FREERTOS_HEAP_SIZE=262144
CONFIG_BOARD_AUTO_RESET=n
CONFIG_F429_SDRAM=y
CONFIG_F429_HEAP_SDRAM=y
CONFIG_F429_LWIP_SDRAM=y
CONFIG_RUNNER_STACK_KB=16
CONFIG_ETH_WIRED=y
CONFIG_LWIP_MEM_SIZE_KB=384
CONFIG_LWIP_PBUF_POOL_SIZE=64
CONFIG_LWIP_TCP_WND=32768
CONFIG_LWIP_TCP_SND_BUF=32768
CONFIG_LWIP_TCP_SND_QUEUELEN=96
CONFIG_LWIP_TCP_SNDLOWAT=16384
CONFIG_LWIP_MEMP_NUM_TCP_SEG=64
CONFIG_CASES="f429_eth"
CONFIG_F429_ETH_TPUT=y
CONFIG_F429_ETH_TPUT_PEER="192.168.0.17"
CONFIG_F429_ETH_TPUT_UDP_MBIT=90
