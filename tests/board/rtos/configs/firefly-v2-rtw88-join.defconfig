# Converted from configs/firefly-v2-rtw88-sdio.mk on 2026-11-02 (BUILD-01 M1).
# Edit this file or run ./make.rtos menuconfig, then regenerate.

# @file    firefly-v2-rtw88-sdio.mk
# @brief   The firefly v2 RTL8821CS image: the vendored rtw88 driver over the
#          linuxkpi SDIO engine and the ported Phytium MCI controller, with the
#          net80211 bridge - the W6-01 round's two exits (a multi-block CMD53
#          read and a scan that lists the surrounding APs).
#
# The card is the board's mmc1 socket (SDIO 024c:c821), the one the MCI round
# already proved can take a CMD53 block write field-for-field like the Linux
# ground truth.  The firmware is compiled in (there is no filesystem on this
# platform): components/linuxkpi/fw/rtw8821c_fw_blob.c, generated by
# tools/rtos/fw-blob.py from the same rtw8821c_fw.bin the Linux lane loads.
#
# The image carries no USB world, so it must not be selected together with the
# 8189FTV or rtw89 profiles: the imported SDIO stack exports its host glue under
# port-carrying names, and one image may compile exactly one port.
#
# Deploy: build/rtos-threadx.bin published as firefly-v2-rtw88-join.bin, loaded
# with `tftpboot 0x90000000 firefly-v2-rtw88-join.bin` and entered with
# `go 0x90000000`.
#
# The W6-02 join arm: the same bring-up and sweep, then the bridge's station
# MLME associates with the open AP named by CONFIG_RTW88_AP_SSID.  The SSID is a
# profile fact (no default): the bench AP changes between rounds.

# --- image -----------------------------------------------------------------

CONFIG_BACKEND_THREADX=y
CONFIG_OPT_O2=y
CONFIG_PROFILE_BASE=y
CONFIG_HEAP_SIZE=16
CONFIG_GMAC_PROF=y
CONFIG_BOARD_FIREFLY_V2=y
CONFIG_CASES="tick rtw88 rtw88_scan rtw88_join"
CONFIG_WLAN_LINE_RTW88=y

# --- the AP this image joins ------------------------------------------------
# Required by the rtw88_join case; the build refuses the case without it.
CONFIG_RTW88_AP_SSID="QiQiJia"

# The tune trace: two lines per channel tune plus the join path's driver
# callbacks.  It is the join arm's diagnostic, so it rides this profile only.
CONFIG_LKPI_JOIN_TRACE=y
