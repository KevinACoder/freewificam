# Converted from configs/rtl8xxxu-8188eu-netio-ar-g.mk on 2026-11-02 (BUILD-01 M1).
# Edit this file or run ./make.rtos menuconfig, then regenerate.

# 8188EUS NETIO on the AR9271 bench AP, legacy 11g (RTOS-01 P3 arm).
#
# Same image shape as rtl8xxxu-8188eu-netio.mk: the ladder, the NETIO server
# over lwIP, the pinned OPP.  The one difference that makes this a named arm is
# the AP the join case pins:
#
#   /home/pi/labwifi-ar-g.conf  ssid=labwifi-ar-g  hw_mode=g  channel=5
#                               ieee80211n=0  wmm_enabled=0  (open)
#
# The 2026-11-01 station split made the AR9271 (ath9k_htc, wlan2) the AP and
# retired the brcmfmac AP that every earlier WLAN arm used; the legacy numbers
# in W5-01 (18.05-18.19) were taken on that retired AP, so RTOS-01 re-takes the
# linuxko legacy reference on this one.  A gate boot that cannot see this SSID
# is an invalid boot, not a slow one.
#
# The OPP stays the W1-01 lever (request 1.992 GHz, delivered ~1.689 GHz) so the
# arm is comparable with the earlier RTOS WLAN cells and with linuxko running
# under schedutil.

CONFIG_BACKEND_FREERTOS=y
CONFIG_OPT_O2=y
CONFIG_PROFILE_BASE=y
CONFIG_HEAP_SIZE=16
CONFIG_FREERTOS_HEAP_SIZE=16777216
CONFIG_GMAC_PROF=y
CONFIG_NETIO_CPU_KHZ=1992000
CONFIG_CASES="tick rtl8xxxu rtl8xxxu_scan rtl8xxxu_join rtl8xxxu_dataplane rtl8xxxu_netio"
CONFIG_RTL8XXXU_EXPECT_MAC="20:f4:1b:52:8f:01"
CONFIG_RTL8XXXU_AP_SSID="labwifi-ar-g"
CONFIG_RTL8XXXU_AP_FREQ=2432
CONFIG_RTL8XXXU_USB_BUS=3
