# F429 -> Pi 4B stream over the wired Ethernet link, stage 4 (video+audio),
# ten-minute window.  See docs/F429-ETH.md and docs/F429-STREAM.md.
#
# The camera and microphone classes are the same ones the AP6181 stream image
# carries; the network half is eth_net.c over the board's LAN8720A (the ST HAL
# ETH closure and the lwIP netif bridge) instead of WICED.  The peer is the
# Pi's wired address, and the address is the router's DHCP lease rather than
# the bench AP's 192.168.99.0/24.
CONFIG_ARCH_ARM_V7M=y
CONFIG_BACKEND_FREERTOS=y
CONFIG_OPT_O2=y
CONFIG_PROFILE_BASE=y
CONFIG_BOARD_STM32F429_CHALLENGER=y
CONFIG_FREERTOS_HEAP_SIZE=1048576
CONFIG_BOARD_AUTO_RESET=n
CONFIG_F429_SDRAM=y
CONFIG_F429_HEAP_SDRAM=y
CONFIG_F429_LWIP_SDRAM=y
CONFIG_RUNNER_STACK_KB=24
CONFIG_ETH_WIRED=y
CONFIG_STREAM_LINK_ETH=y
CONFIG_CASES="pi_stream"
CONFIG_STREAM_STAGE=4
CONFIG_STREAM_WINDOW_MS=600000
CONFIG_STREAM_DHCP=y
CONFIG_STREAM_STATIC_IP="192.168.0.2"
CONFIG_STREAM_PI_IP="192.168.0.17"
CONFIG_STREAM_VIDEO_PORT=5000
CONFIG_STREAM_AUDIO_PORT=5001
CONFIG_LWIP_MEM_SIZE_KB=255
CONFIG_LWIP_PBUF_POOL_SIZE=24
CONFIG_LWIP_TCP_WND=16384
CONFIG_LWIP_TCP_SND_BUF=32768
CONFIG_LWIP_TCP_SND_QUEUELEN=96
CONFIG_LWIP_TCP_SNDLOWAT=8192
CONFIG_LWIP_MEMP_NUM_TCP_SEG=48
CONFIG_LWIP_MEMP_NUM_TCPIP_MSG_INPKT=16
CONFIG_UVC_TARGET_WIDTH=640
CONFIG_UVC_TARGET_HEIGHT=480
CONFIG_UVC_FRAME_BYTES=131072
CONFIG_UAC_TARGET_RATE=16000
