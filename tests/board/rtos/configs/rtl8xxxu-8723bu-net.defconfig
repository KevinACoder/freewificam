# Converted from configs/rtl8xxxu-8723bu-net.mk on 2026-11-02 (BUILD-01 M1).
# Edit this file or run ./make.rtos menuconfig, then regenerate.

# 8723BU ladder, stage 5: the ladder plus the lwIP netif and the two iperf phases
# (downlink server, uplink client).  The peer is the bench AP host's iperf2;
# the Linux reference arm for this line must use the same instrument, not the
# 8723B Linux round's iperf3
# numbers.

CONFIG_BACKEND_FREERTOS=y
CONFIG_OPT_O2=y
CONFIG_PROFILE_BASE=y
CONFIG_HEAP_SIZE=16
CONFIG_FREERTOS_HEAP_SIZE=16777216
CONFIG_GMAC_PROF=y
CONFIG_CASES="tick rtl8xxxu rtl8xxxu_scan rtl8xxxu_join rtl8xxxu_dataplane rtl8xxxu_net"
CONFIG_RTL8XXXU_CHIP_8723BU=y
CONFIG_RTL8XXXU_EXPECT_MAC="88:e6:28:53:10:9c"
CONFIG_RTL8XXXU_AP_SSID="labwifi-mtk24"
CONFIG_RTL8XXXU_AP_FREQ=2432
CONFIG_RTL8XXXU_USB_BUS=1
