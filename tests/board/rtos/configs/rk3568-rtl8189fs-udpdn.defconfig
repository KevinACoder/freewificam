# rtl8189fs on the RTOS line: the C6T arm with the receive-only downlink first
# (CONFIG_C6T_UDP_FIRST).  Same cases and same bench as rk3568-rtl8189fs-c6t;
# only the phase order differs, so one boot answers whether a stall needs the
# board's transmit path to be busy.
#
# Diagnostic arm: its numbers are not the throughput verdict.

CONFIG_BACKEND_FREERTOS=y
CONFIG_OPT_O2=y
CONFIG_PROFILE_BASE=y
CONFIG_HEAP_SIZE=16
CONFIG_CASES="tick rtl8189fs_sta rtl8189fs_c6t"
CONFIG_LIBLINUX80211=y
CONFIG_LIBLINUX80211_SDIO=y
CONFIG_LIBLINUX80211_WIRELESS=y
CONFIG_LIBLINUX80211_RTL8189FS=y
CONFIG_LIBLINUX80211_NET_LWIP=y
CONFIG_C6T_UDP_FIRST=y

CONFIG_FREERTOS_HEAP_SIZE=16777216
