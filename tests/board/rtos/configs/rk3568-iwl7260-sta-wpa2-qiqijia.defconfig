# G2, QiQiJia arm: the AC 7260 is a WPA2-PSK/CCMP station on the external
# 2.4 GHz AP (14:a3:2f:18:07:2c, ch1).  DHCP is preferred; the case falls back
# to a labelled static 192.168.3.200/24 when the AP's broadcast DHCP offer does
# not reach the board.
#
# The passphrase is NOT in this file.  CONFIG_STA_PSK_EXTERNAL makes the case
# include build/kconfig/<profile>/sta_psk.h, generated by tools/rtos/sta-psk.py
# from the STA_PSK environment (gitignored, 0600).
#
# The stack + driver are GPL-2.0-only; this profile's image is a GPL-2.0 link
# product that also redistributes the Intel firmware image (docs/LICENSES.md).

CONFIG_BACKEND_FREERTOS=y
CONFIG_OPT_O2=y
CONFIG_PROFILE_BASE=y
CONFIG_HEAP_SIZE=16
CONFIG_CASES="tick pcie iwl7260_sta_wpa2 iwl7260_c6"
CONFIG_LKPI_SKB_DATA_POOL_NUM=128
CONFIG_LIBLINUX80211=y
CONFIG_LIBLINUX80211_PCI=y
CONFIG_LIBLINUX80211_SDIO=n
CONFIG_LIBLINUX80211_WIRELESS=y
CONFIG_LIBLINUX80211_IWLWIFI=y
CONFIG_LIBLINUX80211_NET_LWIP=y

CONFIG_WPA_STA=y

CONFIG_STA_SSID="QiQiJia"
CONFIG_STA_BSSID=""
CONFIG_STA_FREQ=2412
CONFIG_STA_DHCP=y
CONFIG_STA_FALLBACK_IP="192.168.3.200"
CONFIG_STA_FALLBACK_GW="192.168.3.1"
CONFIG_STA_PEER_CANDIDATES="192.168.0.17 192.168.3.2"
CONFIG_C6_PEER_IP="192.168.0.17"
CONFIG_STA_PSK_EXTERNAL=y

CONFIG_FREERTOS_HEAP_SIZE=16777216
CONFIG_RUNNER_STACK_KB=32
