# Converted from configs/rtw89-8851bu-ehci-scan.mk on 2026-11-02 (BUILD-01 M1).
# Edit this file or run ./make.rtos menuconfig, then regenerate.

# B target path, stage 2: bring-up + scan.  rtw89 runs first (USB/firmware/
# attach/start); rtw89_scan then pumps the bridge's dwell/walk against the bench
# AP on ch5.

CONFIG_BACKEND_FREERTOS=y
CONFIG_OPT_O2=y
CONFIG_PROFILE_BASE=y
CONFIG_HEAP_SIZE=16
CONFIG_FREERTOS_HEAP_SIZE=16777216
CONFIG_GMAC_PROF=y
CONFIG_CASES="tick rtw89 rtw89_scan"
CONFIG_WLAN_LINE_RTW89=y
CONFIG_RTW89_USB_BUS=1

CONFIG_RTW89_AP_SSID="labwifi-ar-ht20s"
CONFIG_RTW89_AP_FREQ=2432
