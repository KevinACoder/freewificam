# Converted from configs/net-netio-raw-attrib.mk on 2026-11-02 (BUILD-01 M1).
# Edit this file or run ./make.rtos menuconfig, then regenerate.

# K2-07 Z7: Z1 + prof on, and the S2C cell now reports too.
#
# The S2C send path never had a prof report, so the TX buckets (memcpy, flush,
# interrupt) were only visible cumulatively. This arm is attribution only:
# nothing here is a throughput number (prof tax ~11%).

CONFIG_BACKEND_FREERTOS=y
CONFIG_OPT_O2=y
CONFIG_PROFILE_BASE=y
CONFIG_HEAP_SIZE=16
CONFIG_FREERTOS_HEAP_SIZE=16777216
CONFIG_LEVERS=""
# CONFIG_LWIP_TCPIP_CORE_LOCKING_INPUT is not set
CONFIG_GMAC_PROF=y
CONFIG_GMAC_RX_HWCSUM=y
CONFIG_GMAC_RX_ZC=y
CONFIG_GMAC_TX_CSUM=y
CONFIG_NETIO_RAW_UDP=y
CONFIG_CASES="net_mdk_netio"
