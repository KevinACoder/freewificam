# F429 -> Pi 4B live stream (audio+video), no window.  See docs/F429-STREAM.md.
#
# The camera classes, the WICED driver and lwIP share one image.  The AP6181
# data image uses 167.6 KB of static SRAM and the camera classes another
# 44.5 KB, so lwIP's heap/pbuf pools and the kernel heap live in the FMC
# SDRAM; the M4 has no data cache and the SDIO port's staging buffer is SRAM,
# so the pbufs stay coherent.
CONFIG_ARCH_ARM_V7M=y
CONFIG_BACKEND_FREERTOS=y
CONFIG_OPT_O2=y
CONFIG_PROFILE_BASE=y
CONFIG_BOARD_STM32F429_CHALLENGER=y
CONFIG_FREERTOS_HEAP_SIZE=1048576
CONFIG_BOARD_AUTO_RESET=n
CONFIG_F429_SDRAM=y
CONFIG_F429_HEAP_SDRAM=y
CONFIG_WICED_AP6181=y
CONFIG_CASES="pi_stream"
CONFIG_RUNNER_STACK_KB=24
CONFIG_STREAM_STAGE=4
CONFIG_STREAM_DHCP=y
CONFIG_STREAM_STATIC_IP="192.168.99.2"
CONFIG_STREAM_PI_IP="192.168.99.1"
CONFIG_STREAM_VIDEO_PORT=5000
CONFIG_STREAM_AUDIO_PORT=5001
CONFIG_LWIP_MEM_SIZE_KB=64
CONFIG_LWIP_PBUF_POOL_SIZE=16
CONFIG_LWIP_TCP_WND=8192
CONFIG_LWIP_TCP_SND_BUF=32768
CONFIG_LWIP_TCP_SND_QUEUELEN=96
CONFIG_LWIP_TCP_SNDLOWAT=16384
CONFIG_LWIP_MEMP_NUM_TCP_SEG=96
CONFIG_LWIP_MEMP_NUM_TCPIP_MSG_INPKT=16
CONFIG_UVC_TARGET_WIDTH=640
CONFIG_UVC_TARGET_HEIGHT=480
CONFIG_UVC_FRAME_BYTES=131072
CONFIG_UAC_TARGET_RATE=16000
CONFIG_STREAM_WINDOW_MS=0
