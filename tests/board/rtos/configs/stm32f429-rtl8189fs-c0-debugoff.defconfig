# C0-only: rtl8189fs with the vendor face trimmed for a station-only F429.
#
# C0-only size ceiling: the delivery-shaped trim plus CONFIG_RTW_DEBUG off.
# NETIF_SG/EFUSE_FILE/LOAD_PHY_FILE off; AP and DEBUG stay on because AP off
# does not compile (vendor fields live behind CONFIG_AP_MODE while unguarded
# code uses them) and DEBUG carries the C3/C4 attach evidence.  Used by
# `./make.rtos s1-driver-compile S1_PROFILE=... S1_DRIVER=rtl8189fs`; the
# image target is expected to fail (no SDIO host adapter), and ci.sh skips it.
CONFIG_ARCH_ARM_V7M=y
CONFIG_BACKEND_FREERTOS=y
CONFIG_OPT_OS=y
CONFIG_DEBUG_G1=y
CONFIG_PROFILE_BASE=y
CONFIG_BOARD_STM32F429_CHALLENGER=y
CONFIG_BOARD_AUTO_RESET=n
CONFIG_CASES="tick"
CONFIG_LIBLINUX80211=y
CONFIG_LIBLINUX80211_CFG80211=y
CONFIG_LIBLINUX80211_MAC80211=n
CONFIG_LIBLINUX80211_SDIO=y
CONFIG_LIBLINUX80211_RTL8189FS=y
CONFIG_LIBLINUX80211_NET_NONE=y
CONFIG_F429_SDRAM=y
CONFIG_F429_HEAP_SDRAM=y
CONFIG_FREERTOS_HEAP_SIZE=4194304
CONFIG_LKPI_SKB_POOL_NUM=8
CONFIG_LKPI_SKB_DATA_POOL_NUM=8
CONFIG_LKPI_SKB_HEAP_HDR_MAX=64
CONFIG_RTL8189FS_MP=n
CONFIG_RTL8189FS_P2P=n
CONFIG_RTL8189FS_CONCURRENT=n
CONFIG_RTL8189FS_POWER_SAVING=n
CONFIG_RTL8189FS_NETIF_SG=n
CONFIG_RTL8189FS_EFUSE_FILE=n
CONFIG_RTL8189FS_LOAD_PHY_FILE=n

CONFIG_RTL8189FS_DEBUG=n
