# Converted from configs/iwlwifi-7260-sjd.mk on 2026-11-02 (BUILD-01 M1).
# Edit this file or run ./make.rtos menuconfig, then regenerate.

# B4-B6 profile: the 7260 ladder's scan, open join and raw-L2 dataplane on the
# net80211 bridge.  The bring-up case stays first (it owns the linuxkpi PCI
# engine, the firmware download and the attach); the three ladder cases only
# read the state it leaves behind.

CONFIG_BACKEND_FREERTOS=y
CONFIG_OPT_O2=y
CONFIG_PROFILE_BASE=y
CONFIG_HEAP_SIZE=16
CONFIG_FREERTOS_HEAP_SIZE=16777216
CONFIG_GMAC_PROF=y
CONFIG_CASES="tick pcie iwl7260 iwl7260_scan iwl7260_join iwl7260_dataplane iwl7260_net"
CONFIG_WLAN_LINE_IWLWIFI=y
# W7-11: the station authorization step (ASSOC -> AUTHORIZED) after an open
# join.  mac80211 runs it right after the association; iwlwifi only lets the
# firmware rate table choose transmit rates for a station at that state
# (mvm/tx.c).  Without it every data frame leaves with rates[0].idx = 0
# (CCK 1 Mbit/s on 2.4 GHz) - the 1.0 Mbit/s the AP reported for this station.
# The A arm is configs/iwlwifi-7260-sjd-noauthz.defconfig.
CONFIG_WLAN_STA_AUTHZ=y
