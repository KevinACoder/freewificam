# G2, Pi arm: the AC 7260 is a WPA2-PSK/CCMP station on the Pi's bench AP.
# The Pi helper turns its wlan2 from open to WPA2 on the same SSID/channel,
# keeps wlan1 as the monitor, and serves the C6 phases from 192.168.99.1.
#
# The stack + driver are GPL-2.0-only; this profile's image is a GPL-2.0 link
# product that also redistributes the Intel firmware image (docs/LICENSES.md).

CONFIG_BACKEND_FREERTOS=y
CONFIG_OPT_O2=y
CONFIG_PROFILE_BASE=y
CONFIG_HEAP_SIZE=16
CONFIG_CASES="tick pcie iwl7260_sta_wpa2 iwl7260_c6"
CONFIG_LKPI_SKB_DATA_POOL_NUM=128
CONFIG_LIBLINUX80211=y
CONFIG_LIBLINUX80211_PCI=y
CONFIG_LIBLINUX80211_SDIO=n
CONFIG_LIBLINUX80211_WIRELESS=y
CONFIG_LIBLINUX80211_IWLWIFI=y
CONFIG_LIBLINUX80211_NET_LWIP=y

# The STA supplicant role (not hostapd).
CONFIG_WPA_STA=y

CONFIG_STA_SSID="labwifi-ar-ht20s"
CONFIG_STA_BSSID="1c:a7:70:de:29:a1"
CONFIG_STA_FREQ=2432
CONFIG_STA_DHCP=n
CONFIG_STA_STATIC_IP="192.168.99.2"
CONFIG_STA_STATIC_MASK="255.255.255.0"
CONFIG_STA_STATIC_GW="192.168.99.1"
CONFIG_STA_PEER_CANDIDATES="192.168.99.1"
CONFIG_C6_PEER_IP="192.168.99.1"
CONFIG_STA_PSK_EXTERNAL=n

CONFIG_FREERTOS_HEAP_SIZE=16777216
CONFIG_RUNNER_STACK_KB=32
