# @file    firefly-v2-aic8800-usb.defconfig
# @brief   The firefly v2 AIC8800D80 image: the CherryUSB PR stack (ZeroCD
#          modeswitch, firmware download, vendor FullMAC, lwIP) over the
#          board's two xHCI roots - the W7-01 bring-up profile.
#
# The dongle ships as a ZeroCD mass-storage device (1111:1111); the MSC class
# switches it (vendor SCSI CDB, no CSW, forced hub re-enumeration, 350 ms) to
# the BootROM (a69c:8d80), the vendor class downloads the five D80 U02 images
# (linked in: wireless-drivers/aic8800/fw/aic8800_fw_blobs.c, generated by
# tools/rtos/aic8800-fw-blobs.py; digests in docs/FIRMWARE-NOTICES.md), and
# the runtime composite (a69c:8d81, WiFi = interface 2) runs the FullMAC.
#
# The aic8800 case is the B0-B4 ladder: both buses started, the modeswitch,
# the firmware lines, READY, the scan table - and, when
# CONFIG_AIC8800_AP_SSID names an AP (WPA2-PSK; the vendor stack implements
# no other mode), associate + DHCP + the stack's own gateway ping.
# The B4 arm's AP: the bench's QiQiJia, switched to WPA2-PSK on 2026-11-03
# for this arm (it was open through the B0-B3 round).
#
# Deploy: build/rtos-threadx.bin published as firefly-v2-aic8800-usb.bin,
# loaded with `setenv ipaddr 192.168.4.29; tftpboot 0x90000000
# firefly-v2-aic8800-usb.bin` and entered with `go 0x90000000` - the image
# links at 0x90000000 (platform baremetal.ld), NOT the SDK's 0x80100000
# default; a wrong base boots partway and wedges at the first thread
# dispatch (no prompt, no exception - power-cycle to recover).

# --- image -----------------------------------------------------------------

CONFIG_BACKEND_THREADX=y
CONFIG_OPT_O2=y
CONFIG_PROFILE_BASE=y
CONFIG_HEAP_SIZE=16
CONFIG_GMAC_PROF=y
CONFIG_BOARD_FIREFLY_V2=y
CONFIG_CASES="tick aic8800"
CONFIG_WLAN_LINE_AIC8800=y

# --- the AP this image joins -------------------------------------------
# Empty SSID would rebuild the bring-up-only image (B0-B3: modeswitch,
# firmware, READY, scan table, stop). This is the B4 arm: QiQiJia, WPA2-PSK.
CONFIG_AIC8800_AP_SSID="QiQiJia"
CONFIG_AIC8800_AP_PSK="paopaojie520"
