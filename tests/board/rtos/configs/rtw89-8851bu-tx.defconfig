# Converted from configs/rtw89-8851bu-tx.mk on 2026-11-02 (BUILD-01 M1).
# Edit this file or run ./make.rtos menuconfig, then regenerate.

# B on the other kernel: same sources, same driver bytes; only the backend
# source set, the backend defines and the link window differ.

CONFIG_BACKEND_THREADX=y
CONFIG_OPT_O2=y
CONFIG_PROFILE_BASE=y
CONFIG_HEAP_SIZE=16
CONFIG_GMAC_PROF=y
CONFIG_CASES="tick rtw89 rtw89_scan rtw89_join rtw89_dataplane"
CONFIG_WLAN_LINE_RTW89=y
CONFIG_RTW89_USB_BUS=3
