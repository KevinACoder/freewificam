# AP6181 attach with the function-1 bulk writes carried in 4-byte byte-mode
# CMD53 transfers (CONFIG_F429_AP6181_F1_BYTE_WRITE).
#
# Diagnostic arm: block-mode writes to function 1 are answered by the command
# but never by the data phase (no CRC status, no DATAEND), while a 4-byte
# byte-mode write lands and reads back on every boot measured.  This profile
# tests whether the firmware can be brought in through the shape the card does
# confirm; the shipping image stays stm32f429-ap6181-attach.
# F429 attach: the onboard AP6181 (BCM43362) over the board's SDIO socket,
# through the vendored brcmfmac FullMAC driver (cfg80211 only; no mac80211).
#
# The SDIO engine enumerates the card, brcmfmac's probe downloads the 43362
# firmware and NVRAM, initialises the chip and registers wlan0; the case
# stops before scan/association/data and prints the attach identity.
CONFIG_ARCH_ARM_V7M=y
CONFIG_BACKEND_FREERTOS=y
CONFIG_OPT_OS=y
CONFIG_DEBUG_G1=y
CONFIG_PROFILE_BASE=y
CONFIG_BOARD_STM32F429_CHALLENGER=y
CONFIG_BOARD_AUTO_RESET=n
CONFIG_CASES="tick ap6181_c3"
CONFIG_LIBLINUX80211=y
CONFIG_LIBLINUX80211_CFG80211=y
CONFIG_LIBLINUX80211_MAC80211=n
CONFIG_LIBLINUX80211_SDIO=y
CONFIG_LIBLINUX80211_BRCMFMAC=y
CONFIG_LIBLINUX80211_NET_NONE=y
CONFIG_F429_SDRAM=y
CONFIG_F429_HEAP_SDRAM=y
CONFIG_F429_SDIO_AP6181=y
CONFIG_F429_AP6181_F1_BYTE_WRITE=y
CONFIG_FREERTOS_HEAP_SIZE=4194304
CONFIG_RUNNER_STACK_KB=32
CONFIG_LKPI_SKB_POOL_NUM=8
CONFIG_LKPI_SKB_DATA_POOL_NUM=8
CONFIG_LKPI_SKB_HEAP_HDR_MAX=64
