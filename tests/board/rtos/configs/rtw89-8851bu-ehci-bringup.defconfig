# Converted from configs/rtw89-8851bu-ehci-bringup.mk on 2026-11-02 (BUILD-01 M1).
# Edit this file or run ./make.rtos menuconfig, then regenerate.

# B target path, stage 1: the 8851BU on the panel's USB2 root (EHCI bus 1),
# bring-up only.  This is the arm that answers the EHCI >=16 KiB bulk question:
# the driver's receive buffers are 20 KiB, above the recorded 16 KiB timeout.

CONFIG_BACKEND_FREERTOS=y
CONFIG_OPT_O2=y
CONFIG_PROFILE_BASE=y
CONFIG_HEAP_SIZE=16
CONFIG_FREERTOS_HEAP_SIZE=16777216
CONFIG_GMAC_PROF=y
CONFIG_CASES="tick rtw89"
CONFIG_RTW89_USB_BUS=1
