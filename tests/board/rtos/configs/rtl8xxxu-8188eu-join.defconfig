# Converted from configs/rtl8xxxu-8188eu-join.mk on 2026-11-02 (BUILD-01 M1).
# Edit this file or run ./make.rtos menuconfig, then regenerate.

# 8188EUS ladder, stage 3: bring-up + scan + open join against the bench AP (MTK, ch5,
# open).  The join is the bridge's own station MLME; no key exchange.

CONFIG_BACKEND_FREERTOS=y
CONFIG_OPT_O2=y
CONFIG_PROFILE_BASE=y
CONFIG_HEAP_SIZE=16
CONFIG_FREERTOS_HEAP_SIZE=16777216
CONFIG_GMAC_PROF=y
CONFIG_CASES="tick rtl8xxxu rtl8xxxu_scan rtl8xxxu_join"
CONFIG_RTL8XXXU_EXPECT_MAC="20:f4:1b:52:8f:01"
CONFIG_RTL8XXXU_AP_SSID="labwifi-brmc"
CONFIG_RTL8XXXU_AP_FREQ=2432
CONFIG_RTL8XXXU_USB_BUS=3
