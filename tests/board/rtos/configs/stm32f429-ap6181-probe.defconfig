# F429 onboard AP6181 (BCM43362) probe: the SDIO card's identity before any
# function driver, on the socket the TF card line shares.
#
# The image carries the imported fsl_sdmmc card service and the ST LL SDMMC
# host glue, not a driver.  PB13 (WL_REG_ON) is driven high for this profile
# only; the TF socket must be empty.  The expected identity is 0x02d0:0xa962,
# four data lines and the 24 MHz ceiling.  The kernel heap is in the core
# board's SDRAM; the card service's staging buffer is 16 KiB.
CONFIG_ARCH_ARM_V7M=y
CONFIG_BACKEND_FREERTOS=y
CONFIG_OPT_O2=y
CONFIG_DEBUG_G1=y
CONFIG_PROFILE_BASE=y
CONFIG_BOARD_STM32F429_CHALLENGER=y
CONFIG_FREERTOS_HEAP_SIZE=4194304
CONFIG_BOARD_AUTO_RESET=n
CONFIG_F429_SDRAM=y
CONFIG_F429_HEAP_SDRAM=y
CONFIG_F429_SDIO_AP6181=y
CONFIG_RUNNER_STACK_KB=32
CONFIG_CASES="tick f429_sdio_probe f429_sdio_engine"
CONFIG_LIBLINUX80211=y
CONFIG_LIBLINUX80211_CFG80211=n
CONFIG_LIBLINUX80211_MAC80211=n
CONFIG_LIBLINUX80211_SDIO=y
CONFIG_LIBLINUX80211_SDIO_PROBE=y
CONFIG_LIBLINUX80211_RTL8189FS=n
CONFIG_LIBLINUX80211_NET_NONE=y
