# Converted from configs/wlan-ping.mk on 2026-11-02 (BUILD-01 M1).
# Edit this file or run ./make.rtos menuconfig, then regenerate.

# Fast packet-loss arm: one backend, WLAN only, 300 sequence-traced pings.

CONFIG_BACKEND_FREERTOS=y
CONFIG_OPT_O2=y
CONFIG_PROFILE_PERF=y
CONFIG_HEAP_SIZE=16
CONFIG_GMAC_PROF=y
# CONFIG_WLAN_OBS is not set
# CONFIG_WLAN_TCP_SINK is not set
CONFIG_WLAN_TCP_SINK_SECONDS=30
# CONFIG_WLAN_UDP_SINK is not set
CONFIG_WLAN_UDP_SINK_SECONDS=30
CONFIG_WLAN_UDP_PORT=5002
CONFIG_WLAN_PING_COUNT=300
CONFIG_WLAN_PING_INTERVAL_MS=100
CONFIG_WLAN_PING_TRACE=y
# CONFIG_WLAN_SCAN_DIAG is not set
CONFIG_WLAN_SCAN_BATCH=1
CONFIG_WLAN_PUMP_PRIO="below"
# CONFIG_WLAN_PUMP_DRAIN is not set
CONFIG_CASES="wlan"
