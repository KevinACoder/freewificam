# Converted from configs/net-netio-raw-tx256-cpu1992-stall.mk on 2026-11-02 (BUILD-01 M1).
# Edit this file or run ./make.rtos menuconfig, then regenerate.

# K2-16 A arm: the transmit-stall probe with the CPU pinned to the failing OPP.
#
# This is the K2-14/K2-15 failing arm (request 1992 MHz, delivered 1.689 GHz)
# plus the probe. The cell should stop after 1000-26000 frames and leave the
# timeline, the OWN map and the kick result on the console.

CONFIG_BACKEND_FREERTOS=y
CONFIG_OPT_O2=y
CONFIG_PROFILE_BASE=y
CONFIG_HEAP_SIZE=16
CONFIG_FREERTOS_HEAP_SIZE=16777216
CONFIG_LEVERS=""
# CONFIG_LWIP_TCPIP_CORE_LOCKING_INPUT is not set
# CONFIG_GMAC_PROF is not set
CONFIG_GMAC_RX_HWCSUM=y
CONFIG_GMAC_RX_ZC=y
CONFIG_GMAC_STALL_PROBE=y
CONFIG_GMAC_TX_CSUM=y
CONFIG_GMAC_TX_RING=256
CONFIG_NETIO_CPU_KHZ=1992000
CONFIG_NETIO_RAW_UDP=y
CONFIG_NETIO_TX_STALL_PROBE=y
CONFIG_CASES="net_mdk_netio"
