# F429 station, transmit-settle arm: the diagnostic image plus one change to the
# SDIO host glue.  The byte-mode CMD53 write is currently ended as soon as the
# byte counter reads zero and the interface's FIFO is empty; the counter drops
# as a word is loaded out of the FIFO, so the last word and its CRC may still be
# on the wire when the glue stops the card's clock.  This arm waits for the
# peripheral's own TXACT flag to clear (bounded) before disabling the data path.
#
# One variable against the diagnostic image: the card-side probes, the vendor's
# receive-stage counters, the polled pump and the verbose attach/join windows
# are the same, so a difference between the two arms is the settle and nothing
# else.
#
# Not a delivery profile.
CONFIG_ARCH_ARM_V7M=y
CONFIG_BACKEND_FREERTOS=y
CONFIG_OPT_OS=y
CONFIG_DEBUG_G1=y
CONFIG_PROFILE_BASE=y
CONFIG_BOARD_STM32F429_CHALLENGER=y
CONFIG_BOARD_AUTO_RESET=n
CONFIG_CASES="tick rtl8189fs_sta"
CONFIG_LIBLINUX80211=y
CONFIG_LIBLINUX80211_CFG80211=y
CONFIG_LIBLINUX80211_MAC80211=n
CONFIG_LIBLINUX80211_SDIO=y
CONFIG_LIBLINUX80211_RTL8189FS=y
CONFIG_LIBLINUX80211_NET_LWIP=y
CONFIG_F429_SDRAM=y
CONFIG_F429_HEAP_SDRAM=y
CONFIG_F429_LWIP_SDRAM=y
CONFIG_FREERTOS_HEAP_SIZE=4194304
CONFIG_RUNNER_STACK_KB=32
CONFIG_LKPI_SKB_POOL_NUM=8
CONFIG_LKPI_SKB_DATA_POOL_NUM=8
CONFIG_LKPI_SKB_HEAP_HDR_MAX=64

# The polled shape that scans: no card-interrupt arm.
CONFIG_STA_PUMP_IRQ=n
CONFIG_STA_DISPATCH_FORCE=y

# Instruments: the card-side probe every second, a 20 ms window over the join,
# and the vendor's receive-stage counters.  All read-only.
CONFIG_STA_CARD_PROBE=y
CONFIG_STA_CARD_PROBE_FAST_MS=20
CONFIG_RTL8189FS_DBG_COUNTER=y

CONFIG_STA_WATCH=y
CONFIG_STA_WATCH_MS=2000
CONFIG_STA_CONNECT_WAIT_MS=20000

# The join's own vendor messages for this diagnosis image (perturbs the join's
# timing by design; not a verdict image).
CONFIG_STA_VERBOSE_JOIN=y
CONFIG_STA_VERBOSE_ATTACH=y

# The arm's one variable.
CONFIG_F4SDIO_TX_SETTLE=y

CONFIG_RTL8189FS_MP=n
CONFIG_RTL8189FS_P2P=n
CONFIG_RTL8189FS_CONCURRENT=n
CONFIG_RTL8189FS_POWER_SAVING=n
CONFIG_RTL8189FS_NETIF_SG=n
CONFIG_RTL8189FS_EFUSE_FILE=n
CONFIG_RTL8189FS_LOAD_PHY_FILE=n
