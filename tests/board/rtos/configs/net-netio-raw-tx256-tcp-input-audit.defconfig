# Converted from configs/net-netio-raw-tx256-tcp-input-audit.mk on 2026-11-02 (BUILD-01 M1).
# Edit this file or run ./make.rtos menuconfig, then regenerate.

# K2-16 B diagnostic arm: the input fix with the zero-copy lifetime auditor.
#
# The input fix (input on the tcpip thread) lifts the peer-to-board TCP cell
# from 33 kB/s to ~40 MB/s, but at that rate lwIP's 'pbuf_free: p->ref > 0'
# assert fires. This arm adds three counters to the zero-copy hand-off -
# wrap over a live wrapper, free of a dead wrapper, and a ready-ring handle
# dequeued while not live - and prints them every 250 ms and again from the
# assert itself, so one boot says which owner lost track.

CONFIG_BACKEND_FREERTOS=y
CONFIG_OPT_O2=y
CONFIG_PROFILE_BASE=y
CONFIG_HEAP_SIZE=16
CONFIG_FREERTOS_HEAP_SIZE=16777216
# CONFIG_LWIP_TCPIP_CORE_LOCKING_INPUT is not set
# CONFIG_GMAC_PROF is not set
CONFIG_GMAC_RX_HWCSUM=y
CONFIG_GMAC_RX_ZC=y
CONFIG_GMAC_TCP_PROBE=y
CONFIG_GMAC_TX_CSUM=y
CONFIG_GMAC_TX_RING=256
CONFIG_NETIO_RAW_UDP=y
CONFIG_NETIO_TCP_PROBE=y
CONFIG_CASES="net_mdk_netio"
