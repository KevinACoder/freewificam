# B (target path) on ThreadX.

CONFIG_BACKEND_THREADX=y
CONFIG_OPT_O2=y
CONFIG_PROFILE_BASE=y
CONFIG_HEAP_SIZE=16
CONFIG_GMAC_PROF=y
CONFIG_CASES="tick rtw89 rtw89_scan rtw89_join rtw89_dataplane"
CONFIG_WLAN_LINE_RTW89=y
CONFIG_RTW89_USB_BUS=1

CONFIG_RTW89_AP_SSID="labwifi-ar-ht20s"
CONFIG_RTW89_AP_FREQ=2432
