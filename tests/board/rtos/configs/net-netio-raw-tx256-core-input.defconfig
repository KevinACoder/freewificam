# Converted from configs/net-netio-raw-tx256-core-input.mk on 2026-11-02 (BUILD-01 M1).
# Edit this file or run ./make.rtos menuconfig, then regenerate.

# K2-16 A/B counter-arm: input on the receive thread (the shipped shape).
#
# The wired netio arm now leaves lwIP's input path on the tcpip thread. This
# arm puts it back on the driver's RX thread (with the one-lock-per-burst
# shape that only works there) so the comparison stays reproducible: on the
# same board the peer-to-board TCP cell runs at tens of kB/s here and at tens
# of MB/s on the default arm, while the UDP cells are unchanged.

CONFIG_BACKEND_FREERTOS=y
CONFIG_OPT_O2=y
CONFIG_PROFILE_BASE=y
CONFIG_HEAP_SIZE=16
CONFIG_FREERTOS_HEAP_SIZE=16777216
CONFIG_LWIP_TCPIP_CORE_LOCKING_INPUT=y
# CONFIG_GMAC_PROF is not set
CONFIG_GMAC_RX_BATCH=y
CONFIG_GMAC_RX_HWCSUM=y
CONFIG_GMAC_RX_ZC=y
CONFIG_GMAC_TX_CSUM=y
CONFIG_GMAC_TX_RING=256
CONFIG_NETIO_RAW_UDP=y
CONFIG_CASES="net_mdk_netio"
