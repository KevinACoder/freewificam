# Converted from configs/firefly-v2-xmac.mk on 2026-11-02 (BUILD-01 M1).
# Edit this file or run ./make.rtos menuconfig, then regenerate.

# @file    firefly-v2-xmac.mk
# @brief   The firefly v2 board image: ThreadX behind CMSIS-RTOS2, the
#          tick/cmsis2 smoke pair plus the on-SoC xmac wired-NIC case.
#
# Deploy: build/rtos-threadx.bin published as firefly-v2-rtos.bin, loaded with
# `tftpboot 0x90000000 firefly-v2-rtos.bin` and entered with
# `go 0x90000000`.

# --- image -----------------------------------------------------------------

CONFIG_BACKEND_THREADX=y
CONFIG_OPT_O2=y
CONFIG_PROFILE_BASE=y
CONFIG_HEAP_SIZE=16
CONFIG_GMAC_PROF=y
CONFIG_BOARD_FIREFLY_V2=y
CONFIG_CASES="tick cmsis2 net_xmac"
CONFIG_LWIP_TCP_WND=240000
CONFIG_LWIP_TCP_RCV_SCALE=2
CONFIG_LWIP_TCP_SND_BUF=60000
