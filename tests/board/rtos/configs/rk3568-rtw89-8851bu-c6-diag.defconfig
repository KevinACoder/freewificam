# rtw89 on the RTOS line, C6T **diagnostic** arm: the same seven throughput
# phases as rk3568-rtw89-8851bu-c6, plus the observation face the C6T stall
# round needs.  It answers "whose queue holds the frames" (skb queue owner
# identity + chain check) and "is the deferred-work service or the kernel
# timer callout the thing that stopped" (workqueue join trace + timer arm/
# fire counters and a one-shot selftest), instead of inferring both from slot
# addresses.
#
# This image is an instrument, not a verdict: a throughput number is only
# written from the clean profile.  The gates and the decision rules are in
# runs/2026-11-14-rtw89-8851bu-c6t2/PREREG.md.
#
# The driver + stack are a GPL-2.0 link product and redistribute the Realtek
# firmware image (docs/LICENSES.md).

CONFIG_BACKEND_FREERTOS=y
CONFIG_OPT_O2=y
CONFIG_PROFILE_BASE=y
CONFIG_HEAP_SIZE=16
CONFIG_CASES="tick rtw89_c5 rtw89_c6"
CONFIG_LIBLINUX80211=y
CONFIG_LIBLINUX80211_PCI=n
CONFIG_LIBLINUX80211_SDIO=n
CONFIG_LIBLINUX80211_USB=y
CONFIG_LIBLINUX80211_WIRELESS=y
CONFIG_LIBLINUX80211_RTW89=y
CONFIG_LIBLINUX80211_NET_LWIP=y
CONFIG_FREERTOS_HEAP_SIZE=16777216
CONFIG_LKPI_USB_CHERRYUSB_STAGE_SIZE=32768
CONFIG_LKPI_USB_CHERRYUSB_STAGE_SLOTS=16
CONFIG_RUNNER_STACK_KB=32
CONFIG_RTW89_C5_PEER_WINDOW_MS=12000
CONFIG_RTW89_USB_BUS=0
CONFIG_C6_PEER_IP="192.168.99.1"
CONFIG_LKPI_SKBQ_DIAG=y
CONFIG_LKPI_WQ_TRACE=y
CONFIG_LKPI_CENSUS=y
CONFIG_LKPI_MEMCMP_TRACE=y
CONFIG_RTW89_C6_SKIP_LOOPBACK=y
