# F429 AP role: the flash-cost probe for the imported hostapd stack.
#
# One question, answered by the linker: what does the AP role cost in flash when
# the AP MLME is the imported NXP hostapd (CONFIG_HOSTAP_AP) instead of the
# port's own minimal MLME?  The case f429_ap_link only takes the AP entry's
# address, so the whole hostapd graph stays in the link closure while nothing
# is started.  No bus, no dongle, no boot dependency.
#
# This profile is a measurement artifact, not a delivery image.  See
# docs/F429-WIFI.md for the AP role's two implementation options and the
# flash budget they are measured against (1 MiB total).
#
# The rest of the image is the shipped wireless image (FMC SDRAM heap, the real
# mac80211/cfg80211 stack, the rtl8xxxu USB driver, lwIP): the size difference
# between this profile and stm32f429-wifi-c6 is the hostapd link cost on this
# platform.
CONFIG_ARCH_ARM_V7M=y
CONFIG_BACKEND_FREERTOS=y
CONFIG_OPT_OS=y
CONFIG_DEBUG_G1=y
CONFIG_PROFILE_BASE=y
CONFIG_BOARD_STM32F429_CHALLENGER=y
CONFIG_FREERTOS_HEAP_SIZE=4194304
CONFIG_BOARD_AUTO_RESET=n
CONFIG_F429_SDRAM=y
CONFIG_F429_HEAP_SDRAM=y
CONFIG_F429_WIFI_STAGE=6
CONFIG_CASES="f429_ap_link"
CONFIG_LIBLINUX80211=y
CONFIG_LIBLINUX80211_PCI=n
CONFIG_LIBLINUX80211_SDIO=n
CONFIG_LIBLINUX80211_USB=y
CONFIG_LIBLINUX80211_WIRELESS=y
CONFIG_LIBLINUX80211_RTL8XXXU=y
CONFIG_LIBLINUX80211_NET_LWIP=y
CONFIG_HOSTAP_AP=y
CONFIG_LKPI_USB_CHERRYUSB_STAGE_SIZE=4096
CONFIG_LKPI_USB_CHERRYUSB_STAGE_SLOTS=4
CONFIG_LKPI_USB_CHERRYUSB_SLOTS=8
CONFIG_LKPI_SKB_POOL_NUM=8
CONFIG_LKPI_SKB_DATA_POOL_NUM=8
CONFIG_RUNNER_STACK_KB=32
CONFIG_LKPI_WQ_TRACE=y
CONFIG_RTL8XXXU_USB_BUS=0
CONFIG_F429_LWIP_SDRAM=y
