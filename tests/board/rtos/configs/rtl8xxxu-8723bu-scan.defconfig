# Converted from configs/rtl8xxxu-8723bu-scan.mk on 2026-11-02 (BUILD-01 M1).
# Edit this file or run ./make.rtos menuconfig, then regenerate.

# 8723BU ladder, stage 2: bring-up + scan.  The 8723B has no hardware scan op either:
# the net80211 bridge walks the 2.4 GHz channels through the driver's
# .sw_scan_start, so the case pumps the dwell entry and the stack's 1 Hz tick.

CONFIG_BACKEND_FREERTOS=y
CONFIG_OPT_O2=y
CONFIG_PROFILE_BASE=y
CONFIG_HEAP_SIZE=16
CONFIG_FREERTOS_HEAP_SIZE=16777216
CONFIG_GMAC_PROF=y
CONFIG_CASES="tick rtl8xxxu rtl8xxxu_scan"
CONFIG_WLAN_LINE_RTL8XXXU=y
CONFIG_RTL8XXXU_CHIP_8723BU=y
CONFIG_RTL8XXXU_EXPECT_MAC="88:e6:28:53:10:9c"
CONFIG_RTL8XXXU_AP_SSID="labwifi-mtk24"
CONFIG_RTL8XXXU_AP_FREQ=2432
CONFIG_RTL8XXXU_USB_BUS=1
