# rtw89 on the RTOS line, gate C4: the same C3 attach, then the real
# NL80211_CMD_TRIGGER_SCAN attribute stream through nl80211's handler chain and
# mac80211 -> rtw89 -> the USB bulk endpoints; the bench AP must appear in the
# BSS table.
#
# Same image configuration as C3 plus the scan case; the case brings the attach
# up itself, so this profile does not chain C3 (a boot that fails to attach fails
# C4 with C3's own anchors beside it, which is the point of the layering).
#
# The driver + stack are a GPL-2.0 link product and redistribute the Realtek
# firmware image (docs/LICENSES.md).

CONFIG_BACKEND_FREERTOS=y
CONFIG_OPT_O2=y
CONFIG_PROFILE_BASE=y
CONFIG_HEAP_SIZE=16
CONFIG_CASES="tick rtw89_c4"
CONFIG_LIBLINUX80211=y
CONFIG_LIBLINUX80211_PCI=n
CONFIG_LIBLINUX80211_SDIO=n
CONFIG_LIBLINUX80211_USB=y
CONFIG_LIBLINUX80211_WIRELESS=y
CONFIG_LIBLINUX80211_RTW89=y
CONFIG_LIBLINUX80211_NET_NONE=y
CONFIG_FREERTOS_HEAP_SIZE=16777216
CONFIG_LKPI_USB_CHERRYUSB_STAGE_SIZE=32768
CONFIG_LKPI_USB_CHERRYUSB_STAGE_SLOTS=16
CONFIG_RUNNER_STACK_KB=32
CONFIG_RTW89_USB_BUS=0
