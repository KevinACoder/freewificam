# Converted from configs/net-netio-raw-tx256-tcp-input.mk on 2026-11-02 (BUILD-01 M1).
# Edit this file or run ./make.rtos menuconfig, then regenerate.

# K2-16 B arm: the receive direction with input on the tcpip thread.
#
# The peer-to-board TCP cell runs at 33 kB/s on the default arm because the
# whole receive burst runs inside the RX thread and the socket reader cannot
# drain until it ends (see net-netio.mk's note). Putting input back on the
# tcpip thread measured 40.7/40.8 MB/s in two boots with the UDP cells
# unchanged.
#
# NOT the default yet: at a real TCP rate the zero-copy receive bridge trips
# lwIP's 'pbuf_free: p->ref > 0' assert within tens of milliseconds (reproduced
# on the deep-mailbox arms before this change and on the promoted default
# image afterwards). The copying bridge is stable but costs the UDP direction
# 114 -> 84 MB/s at 26% loss (net-netio-raw-tx256-tcp-nozc.mk).

CONFIG_BACKEND_FREERTOS=y
CONFIG_OPT_O2=y
CONFIG_PROFILE_BASE=y
CONFIG_HEAP_SIZE=16
CONFIG_FREERTOS_HEAP_SIZE=16777216
# CONFIG_LWIP_TCPIP_CORE_LOCKING_INPUT is not set
# CONFIG_GMAC_PROF is not set
CONFIG_GMAC_RX_HWCSUM=y
CONFIG_GMAC_RX_ZC=y
CONFIG_GMAC_TX_CSUM=y
CONFIG_GMAC_TX_RING=256
CONFIG_NETIO_RAW_UDP=y
CONFIG_CASES="net_mdk_netio"
CONFIG_WLAN_LINE_NONE=y
