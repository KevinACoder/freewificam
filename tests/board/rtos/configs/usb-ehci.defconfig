# Converted from configs/usb-ehci.mk on 2026-11-02 (BUILD-01 M1).
# Edit this file or run ./make.rtos menuconfig, then regenerate.

# A2: the U-disk on the panel's USB2 roots - the controller family the 8851BU
# sits on, so this is the target path's throughput ceiling.  The wrapper tries
# busid 1 then 0 and names the root it measured.

CONFIG_BACKEND_FREERTOS=y
CONFIG_OPT_O2=y
CONFIG_PROFILE_BASE=y
CONFIG_HEAP_SIZE=1
CONFIG_FREERTOS_HEAP_SIZE=1048576
CONFIG_GMAC_PROF=y
CONFIG_CASES="tick usb_ehci"
