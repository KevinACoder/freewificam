# C0-only: the rtl8189fs vendor stack compiled against the F429 face.
#
# Not an image profile: the F429 SDIO host glue is a separate line, so this
# profile exists for `./make.rtos s1-driver-compile S1_PROFILE=... \
# S1_DRIVER=rtl8189fs`, which compiles the 131 vendor TUs with -mcpu=cortex-m4
# and writes their per-object sizes for the size ledger.  The build's image
# target is expected to fail (no SDIO host adapter); tools/build/ci.sh skips
# this file.
CONFIG_ARCH_ARM_V7M=y
CONFIG_BACKEND_FREERTOS=y
CONFIG_OPT_OS=y
CONFIG_DEBUG_G1=y
CONFIG_PROFILE_BASE=y
CONFIG_BOARD_STM32F429_CHALLENGER=y
CONFIG_BOARD_AUTO_RESET=n
CONFIG_CASES="tick"
CONFIG_LIBLINUX80211=y
CONFIG_LIBLINUX80211_CFG80211=y
CONFIG_LIBLINUX80211_MAC80211=n
CONFIG_LIBLINUX80211_SDIO=y
CONFIG_LIBLINUX80211_RTL8189FS=y
CONFIG_LIBLINUX80211_NET_NONE=y
CONFIG_F429_SDRAM=y
CONFIG_F429_HEAP_SDRAM=y
CONFIG_FREERTOS_HEAP_SIZE=4194304
CONFIG_LKPI_SKB_POOL_NUM=8
CONFIG_LKPI_SKB_DATA_POOL_NUM=8
CONFIG_LKPI_SKB_HEAP_HDR_MAX=64
