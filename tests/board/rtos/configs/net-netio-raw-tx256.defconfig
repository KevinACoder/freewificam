# Converted from configs/net-netio-raw-tx256.mk on 2026-11-02 (BUILD-01 M1).
# Edit this file or run ./make.rtos menuconfig, then regenerate.

# K2-07 Z5: Z1 + a 256-descriptor TX ring.
#
# At ring 64 the sender finds the ring full on ~73% of its calls (tx_waits /
# tx_frames), so the CPU parks on the completion semaphore almost every frame.
# A deeper ring lets the CPU stay ahead of the wire instead of rendezvousing
# with every completion: the discriminator is the client's Rx rate and
# tx_waits falling, not tx_occ_max.

CONFIG_BACKEND_FREERTOS=y
CONFIG_OPT_O2=y
CONFIG_PROFILE_BASE=y
CONFIG_HEAP_SIZE=16
CONFIG_FREERTOS_HEAP_SIZE=16777216
# CONFIG_LWIP_TCPIP_CORE_LOCKING_INPUT is not set
# CONFIG_GMAC_PROF is not set
CONFIG_GMAC_RX_HWCSUM=y
CONFIG_GMAC_RX_ZC=y
CONFIG_GMAC_TX_CSUM=y
CONFIG_GMAC_TX_RING=256
CONFIG_NETIO_RAW_UDP=y
CONFIG_CASES="net_mdk_netio"
CONFIG_WLAN_LINE_NONE=y
