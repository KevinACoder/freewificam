+#if defined(CONFIG_USB_DWC2_ISO)
+/*
+ * One isochronous packet has retired.  Record what the controller actually
+ * moved, then either arm the next packet on this channel or complete the URB.
+ * Isochronous transfers have no retry and no per-packet status register: a
+ * halt without XFRC is the only transport-error signal, and it costs exactly
+ * one packet, so the URB continues (the stream engine drops the frame that
+ * packet belongs to).
+ */
+static void dwc2_iso_irq_handler(struct usbh_bus *bus, uint8_t ch_num,
+                                 struct usbh_urb *urb, uint32_t status)
+{
+    struct dwc2_chan *chan = &g_dwc2_hcd[bus->hcd.hcd_id].chan_pool[ch_num];
+    struct usbh_iso_frame_packet *packet;
+    uint32_t remaining;
+    uint32_t count = 0;
+    bool err = false;
+
+    if ((status & USB_OTG_HCINT_CHH) == 0) {
+        /* Not a channel halt: acknowledge and leave the transfer running. */
+        USB_OTG_HC(ch_num)->HCINT = status;
+        return;
+    }
+
+    USB_OTG_HC(ch_num)->HCINT = status;
+
+    if (chan->iso_next >= urb->num_of_iso_packets) {
+        return;
+    }
+
+    packet = &urb->iso_packet[chan->iso_next];
+
+    if (status & USB_OTG_HCINT_XFRC) {
+        remaining = USB_OTG_HC(ch_num)->HCTSIZ & USB_OTG_HCTSIZ_XFRSIZ;
+        count = (remaining <= chan->xferlen) ? (chan->xferlen - remaining) : 0U;
+        if (count > packet->transfer_buffer_length) {
+            count = packet->transfer_buffer_length;
+        }
+        if ((packet->transfer_buffer != NULL) && (count != 0U)) {
+            usb_dcache_invalidate((uintptr_t)packet->transfer_buffer,
+                                  USB_ALIGN_UP(count, CONFIG_USB_ALIGN_SIZE));
+        }
+    } else {
+        err = true;
+    }
+
+    packet->actual_length = count;
+    packet->errorcode = err ? -USB_ERR_IO : 0;
+    urb->actual_length += count;
+    if (err && (urb->errorcode == 0)) {
+        urb->errorcode = -USB_ERR_IO;
+    }
+
+    chan->iso_next++;
+    if (chan->iso_next < urb->num_of_iso_packets) {
+        dwc2_iso_arm_packet(bus, ch_num);
+        return;
+    }
+
+    chan->iso_active = false;
+    dwc2_urb_waitup(urb);
+}
+#endif /* CONFIG_USB_DWC2_ISO */
