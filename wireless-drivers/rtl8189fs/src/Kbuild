# Kbuild for the vendored Realtek RTL8189FS (RTL8188F, SDIO) driver.
#
# The vendor tree keeps its own Makefile, which is what an out-of-tree build
# (`make -C <kernel> M=<tree>`) reads.  In-tree kbuild reads Kbuild first, so
# this file is the build description and the vendor Makefile stays byte
# identical to the imported tree (see the commit message and the manifest
# note in docs/MANIFEST.md).
#
# The object list is the vendor's own link table, taken from
# `make -pn KERNELRELEASE=dumptest src=.` on the imported tree: the
# rtk_core/os_dep/hal/phydm/platform lists plus the conditional
# core/rtw_mp.o, 131 unique objects (the vendor lists
# os_dep/linux/sdio_ops_linux.o twice for the SDIO HCI).
#
# Differences from the vendor Makefile:
#   * -DCONFIG_BR_EXT / -DCONFIG_BR_EXT_BRNAME are dropped: the bridge
#     extension calls br_fdb_find_port(), which only the bridge module exports
#     (CONFIG_BRIDGE=m here), so a built-in driver cannot link it.  The
#     station/AP paths under test do not use the bridge extension.
#   * -DEFUSE_MAP_PATH / -DWIFIMAC_PATH are kept, with the vendor's paths:
#     hal_com.c references the macros unconditionally and only opens the
#     files when they exist.  Neither exists on this board.
#   * -DREALTEK_CONFIG_PATH is kept as well (firmware is compiled in, so it
#     is only a fallback search path for phy parameter files).
#
# The vendor Makefile still computes RTL871X/HCI_NAME/MODULE_NAME and is the
# reference for the out-of-tree build; keep the two object lists in sync by
# re-running the -pn dump when the vendor tree is re-imported.

ccflags-y += -O1
ccflags-y += -Wno-unused-variable -Wno-unused-function -Wno-unused -Wno-date-time
ccflags-y += -I$(src)/include -I$(src)/platform -I$(src)/hal/btc -I$(src)/hal/phydm
ccflags-y += -DCONFIG_LITTLE_ENDIAN -DCONFIG_IOCTL_CFG80211
ccflags-y += -DRTW_USE_CFG80211_STA_EVENT -DCONFIG_CONCURRENT_MODE
ccflags-y += -DCONFIG_RTL8188F -DCONFIG_MP_INCLUDED -DCONFIG_POWER_SAVING
ccflags-y += -DCONFIG_EFUSE_CONFIG_FILE -DCONFIG_LOAD_PHY_PARA_FROM_FILE
ccflags-y += -DREALTEK_CONFIG_PATH=\"/lib/firmware/\"
# The vendor's default search paths for an efuse map and a wifimac file.  Both
# are only opened when the file exists (hal_com.c), and on this board neither
# exists: the efuse is read from the chip and the MAC comes from it.  The
# definitions must still be present, the code references them unconditionally.
ccflags-y += -DEFUSE_MAP_PATH=\"/system/etc/wifi/wifi_efuse_rtl8189fs.map\"
ccflags-y += -DWIFIMAC_PATH=\"/data/wifimac.txt\"
ccflags-y += -DCONFIG_TXPWR_BY_RATE=1 -DCONFIG_TXPWR_BY_RATE_EN=1
ccflags-y += -DCONFIG_TXPWR_LIMIT=1 -DCONFIG_TXPWR_LIMIT_EN=0
ccflags-y += -DCONFIG_RTW_ADAPTIVITY_EN=0 -DCONFIG_RTW_ADAPTIVITY_MODE=0
ccflags-y += -DHIGH_ACTIVE_HST2DEV=0 -DCONFIG_RTW_SDIO_PM_KEEP_POWER
ccflags-y += -DCONFIG_RTW_NETIF_SG -DCONFIG_RTW_DEBUG -DCONFIG_PROC_DEBUG
ccflags-y += -DRTW_LOG_LEVEL=4 -DDM_ODM_SUPPORT_TYPE=0x04
# Monitor mode is one of the three roles this port has to characterise
# (AP/STA/MONITOR), and the vendor build description defaults it off
# (Makefile: CONFIG_WIFI_MONITOR = n).  The flag admits
# NL80211_IFTYPE_MONITOR in the wiphy and compiles the receiver path that
# already exists in the vendor tree.  It is RX-only here: the vendor's
# CONFIG_MONITOR_MODE_XMIT injector stays off.
ccflags-y += -DCONFIG_WIFI_MONITOR

obj-$(CONFIG_RTL8189FS) += rtl8189fs.o

