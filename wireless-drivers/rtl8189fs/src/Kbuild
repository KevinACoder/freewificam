# The vendor Makefile adds this one conditionally on CONFIG_MP_INCLUDED, which
# is on in the build description above:
#   $(MODULE_NAME)-$(CONFIG_MP_INCLUDED) += core/rtw_mp.o
rtl8189fs-y += core/rtw_mp.o
