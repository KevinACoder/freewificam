# Wireless driver options.
#
# The driver source lists and the per-driver flag worlds stay in the make
# fragments (docs/BUILD-DESIGN.md lists the seven classes Kconfig cannot
# express); this file only owns the values the old profiles carried as
# CONFIG_... make variables.

menu "Wireless drivers"

choice WLAN_LINE
	prompt "Wireless driver line"
	default WLAN_LINE_NONE
	help
	  The one wireless driver family this image links.  The source lists use
	  these symbols (and the derived face symbols below) instead of inferring
	  the line from the case string; the case list still selects the ladder
	  that runs.  One image links at most one wireless line: the bridges and
	  the SDIO host glue are not multi-instance.

config WLAN_LINE_NONE
	bool "none (wired, storage or camera only)"

config WLAN_LINE_RTL8XXXU
	bool "rtl8xxxu over USB"

config WLAN_LINE_RTW89
	bool "rtw89 over USB"

config WLAN_LINE_RTW88
	bool "rtw88 over SDIO or USB"

config WLAN_LINE_IWLWIFI
	bool "iwlwifi over PCIe"

config WLAN_LINE_RTL8189FS
	bool "rtl8189fs vendor stack over SDIO"

endchoice

# One rtw88 image links exactly one bus port.  The SDIO arm is the RTL8821CS
# on the board's mmc1 socket; the USB arm is the RTL8821CU on the RK3568
# roots.  The driver core, the firmware blob and the net80211 bridge are the
# same in both; only the port units, the probe and the case ladder differ.
choice RTW88_BUS
	prompt "rtw88 bus"
	default RTW88_BUS_SDIO
	help
	  The SDIO arm owns the mmc1 socket and its MCI controller; the USB arm
	  owns one xHCI/EHCI root pair and the linuxkpi USB engine.  The two do
	  not share an image: the controller glue and the probe path differ.

config RTW88_BUS_SDIO
	bool "SDIO (RTL8821CS, mmc1)"

config RTW88_BUS_USB
	bool "USB (RTL8821CU, xHCI/EHCI roots)"

endchoice

# The faces a line pulls in.  These are visible so the generated make config
# carries them (kconfiglib writes only symbols with a prompt); their defaults
# follow the line, and a profile does not name them.  A defconfig that turns
# one off while its line is selected fails the source-list check, not the
# compiler.
config NET80211
	bool "net80211 MLME stack"
	default y if WLAN_LINE_RTL8XXXU || WLAN_LINE_RTW89 || WLAN_LINE_RTW88 || WLAN_LINE_IWLWIFI
	help
	  The NetBSD net80211 core, its port and the wlan_bridge seam.

config LINUXKPI
	bool "linuxkpi Linux face"
	default y if WLAN_LINE_RTL8XXXU || WLAN_LINE_RTW89 || WLAN_LINE_RTW88 || WLAN_LINE_IWLWIFI || WLAN_LINE_RTL8189FS
	help
	  The Linux-shaped kernel API the wireless drivers compile against.

config LINUXKPI_NET80211
	bool "linuxkpi net80211 glue"
	default y if NET80211
	help
	  The linuxkpi-side net80211 glue and the seam adapter that joins the
	  bridge to the linuxkpi netdev.

config LINUXKPI_USB
	bool "linuxkpi USB engine"
	default y if WLAN_LINE_RTL8XXXU || WLAN_LINE_RTW89 || (WLAN_LINE_RTW88 && RTW88_BUS_USB)

config LINUXKPI_PCI
	bool "linuxkpi PCI engine"
	default y if WLAN_LINE_IWLWIFI

config LINUXKPI_SDIO
	bool "linuxkpi SDIO engine"
	default y if (WLAN_LINE_RTW88 && RTW88_BUS_SDIO) || WLAN_LINE_RTL8189FS

config LINUXKPI_CENSUS
	bool "linuxkpi census"
	default y if WLAN_LINE_RTL8189FS


choice RTL8XXXU_CHIP
	prompt "rtl8xxxu chip"
	default RTL8XXXU_CHIP_8188EU
	help
	  The chip the rtl8xxxu image binds.  8188EU is the xHCI arm; 8723BU is
	  the EHCI arm (and the 1T1R part the BA reorder-window work measured).

config RTL8XXXU_CHIP_8188EU
	bool "RTL8188EU"

config RTL8XXXU_CHIP_8723BU
	bool "RTL8723BU"

endchoice

config RTL8XXXU_EXPECT_MAC
	string "Expected station MAC (identity gate)"
	default "20:f4:1b:52:8f:01"

config RTL8XXXU_AP_SSID
	string "Bench AP SSID"
	default "labwifi-brmc"

config RTL8XXXU_AP_FREQ
	int "Bench AP frequency (MHz)"
	default 2432

config RTL8XXXU_USB_STAGE_SIZE
	int "rtl8xxxu USB transfer stage size (bytes)"
	default 4096

config RTL8XXXU_HB
	bool "Heartbeat"
	help
	  Rendered as the bare -DRTL8XXXU_HB by the driver fragment; it is a
	  make variable, not a CFG_DEFS token.

config NET_WATCH
	bool "net_watch USB/stack observation"
	help
	  The rtl8xxxu net_watch counters.  The make variable gates
	  net_watch.c in the driver fragment; the generated config header also
	  defines NET_WATCH, so no compile-line -D is needed.

config RTL8XXXU_USB_BUS
	int "rtl8xxxu USB bus id (0/1/3/4)"
	default 3
	help
	  The old profiles used the controller's bus id directly: 3 = xHCI,
	  1 = both USB2 roots, 4 = all four roots, 0 = the first USB2 root.
	  The migration keeps the numbers; the transport-choice redesign is a
	  later step.

config RTW89_USB_BUS
	int "rtw89 USB bus id"
	default 3

config RTW88_USB_BUS
	int "rtw88 USB bus id (3 = xHCI roots 3,2; 1 = USB2 roots 1,0)"
	default 3
	help
	  The old profiles used the controller's bus id directly: 3 = xHCI,
	  1 = both USB2 roots.  The migration keeps the numbers.

# The RTL8821CS data-plane cases' profile facts.  Both are named in a defconfig
# and neither has a default: the bench AP changes between rounds, and the
# address mode decides whether the image asks the AP or configures itself.  An
# image that selects the case without them fails at build time (see
# tests/board/rtos/build/rtw88_sdio.mk and docs/PLATFORM-FACTS.md).
config RTW88_AP_SSID
	string "AP SSID the rtw88 join arm associates with"
	help
	  The open AP the join case looks up in the scan table.  It is a string,
	  not a BSSID: the driver line must not pin an address the AP is free to
	  change, so the case picks the strongest row carrying this SSID.

config RTW88_EXPECT_MAC
	string "Expected station MAC for the rtw88 USB arm (identity gate)"
	default "54:c9:e0:00:29:66"
	help
	  The bench carries several Realtek dongles on the same roots; the USB
	  bring-up case refuses an attach whose hardware address differs from
	  this one.  The SDIO arm's identity is its socket, so it ignores it.

config RTW88_NET_ADDR_DHCP
	bool "rtw88 net arm: address from the AP's DHCP"

config RTW88_NET_ADDR_STATIC
	bool "rtw88 net arm: static address"

config RTW88_NET_IP
	string "rtw88 net arm: static address"
	help
	  Required by CONFIG_RTW88_NET_ADDR_STATIC only (the build refuses the
	  arm without it).

config RTW88_NET_MASK
	string "rtw88 net arm: static netmask"

config RTW88_NET_GW
	string "rtw88 net arm: static gateway"

endmenu
