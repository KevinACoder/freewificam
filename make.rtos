#!/bin/sh
# make.rtos - the RTOS image and test entry.
#
# One Kconfig tree, one generated fragment, one make.  The profile is a
# defconfig under tests/board/rtos/configs/; `list` prints them, `config`
# regenerates build/kconfig/<profile>/generated/config.mk, and the build
# targets run the platform Makefile with that profile.
#
# Usage:
#   ./make.rtos list [--current]
#   ./make.rtos config [PROFILE=<name>]
#   ./make.rtos image|images|libs|check|check-no-d|check-config-header|check-build-contract|case-list-check|matrix|dump-vars|clean|distclean
#   ./make.rtos rk3568_ci
#   PROFILE=<name> ./make.rtos image
#   ./make.rtos --profile <name> image

set -eu

here=$(cd "$(dirname "$0")" && pwd)
cd "$here"

case "${1:-}" in
    --profile)
        shift
        [ $# -gt 0 ] || { echo "make.rtos: --profile needs a name" >&2; exit 2; }
        PROFILE=$1
        export PROFILE
        shift
        ;;
    --profile=*)
        PROFILE=${1#*=}
        export PROFILE
        shift
        ;;
esac

if [ "${1:-}" = "list" ] && [ "${2:-}" = "--current" ]; then
    shift 2
    set -- list CURRENT=1 "$@"
fi

exec make -f tools/build/rtos.mk "$@"
